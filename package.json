{
  "name": "gleaph-workspace",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "install:all": "vp install && pnpm sdk:build",
    "check": "vp run -r check",
    "test": "vp run -r test",
    "build": "vp run -r build",
    "pack": "vp run -r pack",
    "sdk:check": "pnpm --filter @gleaph/sdk run check",
    "sdk:test": "pnpm --filter @gleaph/sdk run test",
    "sdk:build": "pnpm --filter @gleaph/sdk run build",
    "sdk:pack": "pnpm --filter @gleaph/sdk run pack",
    "codegen:check-fixtures": "sh scripts/check-codegen-fixtures.sh",
    "codegen:e2e:local": "sh scripts/check-codegen-local-e2e.sh",
    "dashboard:dev": "pnpm --filter @gleaph/dashboard dev",
    "dashboard:check": "pnpm --filter @gleaph/dashboard run check",
    "dashboard:build": "pnpm --filter @gleaph/dashboard run build",
    "social-demo:dev": "pnpm --filter @gleaph/social-demo dev",
    "social-demo:check": "pnpm --filter @gleaph/social-demo check",
    "social-demo:build": "pnpm --filter @gleaph/social-demo build"
  },
  "devDependencies": {
    "oxlint": "^1.78.0",
    "vite-plus": "^0.2.1"
  }
}
