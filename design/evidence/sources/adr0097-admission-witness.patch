+    #[test]
+    fn a0_admission_pair() {
+        let left = FreeSpan { start_slot: 6, len: 4 };
+        let middle = FreeSpan { start_slot: 20, len: 4 };
+        let peer = FreeSpan { start_slot: 40, len: 4 };
+        for (right, replacement, expected_error, phase) in [
+            (left, left, FreeSpanError::MissingSpan { span: left }, "same-input"),
+            (middle, peer, FreeSpanError::DuplicateStart { start_slot: 40 }, "replacement-key"),
+        ] {
+            let manager = MemoryManager::init(DefaultMemoryImpl::default());
+            let memories = [
+                manager.get(MemoryId::new(10)),
+                manager.get(MemoryId::new(11)),
+            ];
+            let store = FreeSpanStore::init(memories[0].clone(), memories[1].clone()).unwrap();
+            for span in [left, middle, peer] {
+                store.release(span).unwrap();
+            }
+            store.validate().unwrap();
+            let before = admission_snapshot(&store, &memories);
+            let empty = FreeSpan { start_slot: 6, len: 0 };
+            let missing_left = FreeSpan { start_slot: 6, len: 5 };
+            let missing_right = FreeSpan { start_slot: 20, len: 5 };
+            let overflow = FreeSpan { start_slot: u64::MAX, len: 1 };
+            let overlap = FreeSpan { start_slot: 39, len: 6 };
+            for (a, b, target, expected) in [
+                (missing_left, missing_right, empty, FreeSpanError::MissingSpan { span: missing_left }),
+                (left, missing_right, empty, FreeSpanError::MissingSpan { span: missing_right }),
+                (left, right, empty, FreeSpanError::EmptySpan),
+                (left, right, overflow, FreeSpanError::SpanOverflow { span: overflow }),
+                (left, right, overlap, FreeSpanError::OverlapNext { inserted: overlap, next: peer }),
+            ] {
+                assert_eq!(store.replace_exact_pair_with(a, b, target), Err(expected));
+                assert!(admission_snapshot(&store, &memories) == before, "{phase}: precedence rejection changed state");
+            }
+            eprintln!("ADMISSION_PAIR {phase}: precedence passed; reached primary rejection");
+            assert_eq!(
+                store.replace_exact_pair_with(left, right, replacement),
+                Err(expected_error)
+            );
+            let after = admission_snapshot(&store, &memories);
+            assert!(before == after, "{phase}: pair rejection changed backing or heap");
+            assert_eq!(store.spans(), vec![left, middle, peer]);
+            assert_allocator_stats_match_spans(&store);
+            store.validate().unwrap();
+            eprintln!("ADMISSION_PAIR {phase}: unchanged ownership verified");
+        }
+    }
