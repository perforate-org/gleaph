+    let mut shared = diag_tick();
+    for _ in 0..32 {
+        shared = diag_finish(DIAG_CAL_SHARED, shared);
+    }
+}
+#[cfg(feature = "canbench")]
+fn diag_cal_summary() -> [[u64; 4]; 4] {
+    DIAG.with(|d| {
