+// Fixed-size observational recorder for the one authorized cfg-gated diagnostic.
+// A pair value is exit-counter minus entry-counter. Bookkeeping after a finish's
+// timestamp (or before a tick's) is outside that call's own sample, but a shared
+// endpoint places the preceding finish's bookkeeping inside the following sibling's
+// sample, and nested samples make inner recorder work parent-charged. Calibration
+// uses the identical tick/finish paths; outputs are observational only, not certified
+// cost or ranking bounds.
+#[cfg(feature = "canbench")]
+#[derive(Clone, Copy)]
+struct DiagAgg {
+    count: u64,
+    sum: u64,
+    min: u64,
+    max: u64,
+}
+#[cfg(feature = "canbench")]
+impl DiagAgg {
+    const ZERO: Self = Self {
+        count: 0,
+        sum: 0,
+        min: u64::MAX,
+        max: 0,
+    };
+    fn update(&mut self, delta: u64) {
+        self.count += 1;
+        self.sum += delta;
+        self.min = self.min.min(delta);
+        self.max = self.max.max(delta);
+    }
+}
+#[cfg(feature = "canbench")]
+struct DiagState {
+    agg: [DiagAgg; DIAG_SLOTS],
+    endpoints: u64,
+}
+#[cfg(feature = "canbench")]
+impl DiagState {
+    const ZERO: Self = Self {
+        agg: [DiagAgg::ZERO; DIAG_SLOTS],
+        endpoints: 0,
+    };
+}
+#[cfg(feature = "canbench")]
+std::thread_local! {
+    static DIAG: std::cell::RefCell<DiagState> =
+        const { std::cell::RefCell::new(DiagState::ZERO) };
+}
+#[cfg(feature = "canbench")]
+fn diag_tick() -> u64 {
+    DIAG.with(|d| d.borrow_mut().endpoints += 1);
+    ic_cdk::api::performance_counter(0)
+}
+#[cfg(feature = "canbench")]
+fn diag_finish(slot: usize, t0: u64) -> u64 {
+    let t = ic_cdk::api::performance_counter(0);
+    DIAG.with(|d| {
+        let mut d = d.borrow_mut();
+        d.endpoints += 1;
+        d.agg[slot].update(t - t0);
+    });
+    t
+}
+#[cfg(feature = "canbench")]
+fn diag_reset() {
+    DIAG.with(|d| {
