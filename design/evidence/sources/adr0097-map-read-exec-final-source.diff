+            DIAG_CAL_STANDALONE,
+            DIAG_CAL_NESTED_IN,
+            DIAG_CAL_SHARED,
+            DIAG_CAL_NESTED_OUT,
+        ];
+        for (row, slot) in slots.into_iter().enumerate() {
+            out[row] = [
+                d.agg[slot].count,
+                d.agg[slot].sum,
+                d.agg[slot].min,
+                d.agg[slot].max,
+            ];
+        }
+        out
+    })
