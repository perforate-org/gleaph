+        d.endpoints = 0;
+        for slot in d.agg.iter_mut().take(DIAG_CATS) {
+            *slot = DiagAgg::ZERO;
+        }
+    });
+}
+#[cfg(feature = "canbench")]
+fn diag_snapshot(acc: &mut [u64; DIAG_CATS], pairs: &mut [u64; DIAG_CATS], endpoints: &mut u64) {
+    DIAG.with(|d| {
+        let d = d.borrow();
+        for slot in 0..DIAG_CATS {
+            acc[slot] = d.agg[slot].sum;
+            pairs[slot] = d.agg[slot].count;
+        }
+        *endpoints = d.endpoints;
+    });
+}
+#[cfg(feature = "canbench")]
+fn diag_run_calibration() {
+    for _ in 0..64 {
