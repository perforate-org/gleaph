+    fn selected_property_tree_eight_byte_boundaries() {
+        check_selected_tree_property(8);
+    }
+
+    #[test]
+    fn selected_property_tree_thirty_three_byte_boundaries() {
+        check_selected_tree_property(33);
+    }
