+            .read_label_bucket_slot(bucket_slot)
+            .unwrap()
+            .is_tiny_mode()
+    );
+    let before = snapshot();
+    assert_point_states(&graph, owner, label, &expected);
+    assert_eq!(snapshot(), before);
