  "configuration": {
    "/Users/yota/dev/gleaph-spill/.cargo/config.toml": {
      "sha256": "e5aab3aba2c680e4d3fdd0c91635a31ae97a5a4e9c220b3e46ab55d63a841b88",
      "size": 937,
      "text": "# Canister artifacts are wasm32 (production target; matches the canbench benchmark builds and the\n# PocketIC E2E suite). SIMD (simd128) is enabled for every wasm32 build. Scoping rustflags to the\n# wasm32 target keeps host-side builds (cargo test/clippy) untouched and applies uniformly to\n# pocket-ic E2E, dfx/icp, and manual builds.\n[target.wasm32-unknown-unknown]\nrustflags = [\"-C\", \"target-feature=+simd128\"]\n\n# Kept for a possible future re-switch to wasm64 (not the current production target). Stable\n# memory survives width-change upgrades in both directions, so re-switching never strands data.\n# wasm64 has no prebuilt std: such a build would additionally need nightly\n# `-Z build-std=core,alloc,std,panic_abort` on top of these SIMD rustflags.\n[target.wasm64-unknown-unknown]\nrustflags = [\"-C\", \"target-feature=+simd128\"]\n\n[unstable]\nmin-publish-age = true\nembed-metadata = false\n\n[registry]\nglobal-min-publish-age = \"14 days\"\n"
    },
