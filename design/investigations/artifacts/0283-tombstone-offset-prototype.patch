+fn maintenance_budget(checkpoint_every: u32) -> MaintenanceBudget {
+    MaintenanceBudget {
+        max_instructions: 5_000_000,
+        reserve_instructions: 0,
+        checkpoint_every,
+        max_work_items: Some(1),
+        max_segments: Some(1),
+        max_delete_edge_steps: Some(1),
+    }
+}
+
+fn drain_offset_maintenance(
+    fixture: &DeferredOffsetFixture,
+    checkpoint_every: u32,
+) -> (u32, u32) {
+    let mut calls = 0u32;
+    let mut rebalanced = 0u32;
+    while fixture.graph.maintenance_queue_len() > 0 {
+        let before = fixture.graph.maintenance_queue_len();
+        let report = fixture
+            .graph
+            .maintenance(maintenance_budget(checkpoint_every));
+        calls += 1;
+        rebalanced += report.rebalanced_segments;
+        assert_eq!(report.processed_work_items, 1);
+        assert_eq!(report.remaining_queue_len, fixture.graph.maintenance_queue_len());
+        assert!(report.remaining_queue_len < before || report.processed_work_items > 0);
+    }
+    assert_eq!(calls, 1_025);
+    assert_eq!(rebalanced, 1);
+    (calls, rebalanced)
+}
