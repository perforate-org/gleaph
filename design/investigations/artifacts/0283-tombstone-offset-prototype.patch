+fn visit_offset_candidate_window<B>(
+    graph: &LabeledLaraGraph<BenchEdge, crate::VectorMemory>,
+    request: &LabeledTraversalRequest,
+    window: TraversalWindow,
+    directory: &OffsetDirectory,
+    candidate: OffsetCandidate,
+    mut visit: impl FnMut(BucketEntryPosition, BenchEdge) -> std::ops::ControlFlow<B>,
+) -> std::ops::ControlFlow<B> {
+    let vertex = graph.vertices().get(request.owner);
+    let bucket = graph
+        .buckets()
+        .read_label_bucket_slot(vertex.base_slot_start())
+        .expect("candidate label bucket");
+    assert_eq!(bucket.bucket_label_key(), request.label);
+    let (block, mut skip_in_block) =
+        locate_candidate_block(directory, candidate, request.order, window.offset);
+    let block_start = block as u32 * OFFSET_BLOCK_SLOTS;
+    let block_end = (block_start + OFFSET_BLOCK_SLOTS).min(bucket.stored_slots);
+    let mut remaining = window.limit.unwrap_or(u32::MAX);
+    let mut scan_slot = match request.order {
+        OutEdgeOrder::Ascending => block_start as i64,
+        OutEdgeOrder::Descending => i64::from(block_end) - 1,
+    };
+    while remaining > 0 && (0..i64::from(bucket.stored_slots)).contains(&scan_slot) {
+        let logical_slot = scan_slot as u32;
+        let edge = graph
+            .edges()
+            .read_slot(bucket.edge_start() + u64::from(logical_slot));
+        if !edge.is_tombstone_edge() && !edge.is_deleted_slot() {
+            if skip_in_block > 0 {
+                skip_in_block -= 1;
+            } else {
+                remaining -= 1;
+                if let std::ops::ControlFlow::Break(value) =
+                    visit(BucketEntryPosition::new(logical_slot), edge)
+                {
+                    return std::ops::ControlFlow::Break(value);
+                }
+            }
+        }
+        match request.order {
+            OutEdgeOrder::Ascending => scan_slot += 1,
+            OutEdgeOrder::Descending => scan_slot -= 1,
+        }
+    }
+    assert_eq!(remaining, 0);
+    std::ops::ControlFlow::Continue(())
+}
+
+fn candidate_slot_at_ordinal(
+    fixture: &OffsetFixture,
+    directory: &OffsetDirectory,
+    candidate: OffsetCandidate,
+    order: OutEdgeOrder,
+    ordinal: u32,
+) -> (BucketEntryPosition, u32) {
+    let request = LabeledTraversalRequest {
+        owner: fixture.src,
+        label: fixture.label,
+        order,
+    };
+    let mut row = None;
+    let result = visit_offset_candidate_window(
+        &fixture.graph,
+        &request,
+        TraversalWindow::new(ordinal, Some(1)),
+        directory,
+        candidate,
+        |slot, edge| {
+            row = Some((slot, edge.0));
+            std::ops::ControlFlow::<()>::Continue(())
+        },
+    );
+    assert_eq!(result, std::ops::ControlFlow::Continue(()));
+    row.expect("candidate row")
+}
+
+fn assert_candidate_parity(
+    fixture: &OffsetFixture,
+    directory: &OffsetDirectory,
+    candidate: OffsetCandidate,
+) {
+    for order in [OutEdgeOrder::Ascending, OutEdgeOrder::Descending] {
+        for ordinal in 0..OFFSET_LIVE_ROWS {
+            let expected = match order {
+                OutEdgeOrder::Ascending => fixture.truth[ordinal as usize],
+                OutEdgeOrder::Descending => {
+                    fixture.truth[OFFSET_LIVE_ROWS as usize - 1 - ordinal as usize]
+                }
+            };
+            assert_eq!(
+                candidate_slot_at_ordinal(fixture, directory, candidate, order, ordinal),
+                expected
+            );
+        }
+        for ordinal in [31, 32, 33, 959, 960, 991, 1_023] {
+            black_box(candidate_slot_at_ordinal(
+                fixture, directory, candidate, order, ordinal,
+            ));
+        }
+    }
+
+    let removed = fixture.truth[OFFSET_WINDOW_OFFSET as usize];
+    let rebuilt_truth: Vec<_> = fixture
+        .truth
+        .iter()
+        .copied()
+        .filter(|row| *row != removed)
+        .collect();
+    let rebuilt = build_offset_directory(
+        &rebuilt_truth,
+        directory.block_counts.len() as u32 * OFFSET_BLOCK_SLOTS,
+    );
+    let removed_block = (removed.0.raw() / OFFSET_BLOCK_SLOTS) as usize;
+    assert_eq!(
+        rebuilt.block_counts[removed_block] + 1,
+        directory.block_counts[removed_block]
+    );
+    assert_eq!(
+        rebuilt.group_counts[removed_block / OFFSET_GROUP_BLOCKS] + 1,
+        directory.group_counts[removed_block / OFFSET_GROUP_BLOCKS]
+    );
+}
+
+fn assert_candidate_window_rows(
+    fixture: &OffsetFixture,
+    directory: &OffsetDirectory,
+    candidate: OffsetCandidate,
+) {
+    let request = LabeledTraversalRequest {
+        owner: fixture.src,
+        label: fixture.label,
+        order: OutEdgeOrder::Ascending,
+    };
+    let window = TraversalWindow::new(OFFSET_WINDOW_OFFSET, Some(OFFSET_WINDOW_LIMIT));
+    let expected = expected_offset_window_rows(&fixture.truth, request.order, window.offset);
+    let mut rows = Vec::new();
+    let result = visit_offset_candidate_window(
+        &fixture.graph,
+        &request,
+        window,
+        directory,
+        candidate,
+        |slot, edge| {
+            rows.push((slot, edge.0));
+            std::ops::ControlFlow::<()>::Continue(())
+        },
+    );
+    assert_eq!(result, std::ops::ControlFlow::Continue(()));
+    assert_eq!(rows, expected);
+}
