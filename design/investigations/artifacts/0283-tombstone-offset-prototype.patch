+fn build_deferred_offset_fixture(checkpoint_every: u32) -> DeferredOffsetFixture {
+    let extent = 8_192;
+    let stride = 8;
+    let (inner, src, label) = build_dense_offset_graph(extent);
+    let graph = DeferredLabeledLaraGraph::new(inner, vector_memory()).expect("deferred graph");
+    for slot in 0..extent {
+        if slot % stride != 0 {
+            assert!(
+                graph
+                    .remove_edge_matching(src, label, |edge| edge.0 == offset_target(slot))
+                    .unwrap()
+                    .is_some()
+            );
+        }
+    }
+    assert!(graph.maintenance_queue_len() > 0);
+    let truth = collect_offset_truth(graph.inner(), src, label, extent, stride);
+    assert_eq!(checkpoint_every == 1 || checkpoint_every == u32::MAX, true);
+    DeferredOffsetFixture {
         graph,
         src,
         label,
         truth,
+    }
