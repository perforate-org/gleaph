+fn offset_candidate_bench(
+    extent: u32,
+    stride: u32,
+    candidate: OffsetCandidate,
+) -> canbench_rs::BenchResult {
+    let fixture = build_offset_fixture(extent, stride);
+    let directory = build_offset_directory(&fixture.truth, extent);
+    assert_candidate_parity(&fixture, &directory, candidate);
+    assert_candidate_window_rows(&fixture, &directory, candidate);
+    let request = LabeledTraversalRequest {
+        owner: fixture.src,
+        label: fixture.label,
+        order: OutEdgeOrder::Ascending,
+    };
+    let window = TraversalWindow::new(OFFSET_WINDOW_OFFSET, Some(OFFSET_WINDOW_LIMIT));
+    bench_fn(|| {
+        let mut count = 0u32;
+        let mut checksum = 0u64;
+        let control = visit_offset_candidate_window(
+            &fixture.graph,
+            &request,
+            window,
+            &directory,
+            candidate,
+            |slot, edge| {
+                count += 1;
+                checksum = checksum
+                    .wrapping_add(u64::from(slot.raw()).wrapping_mul(31))
+                    .wrapping_add(u64::from(edge.0));
+                black_box((slot.raw(), edge.0));
+                std::ops::ControlFlow::<()>::Continue(())
+            },
+        );
+        black_box((control.is_continue(), count, checksum));
+    })
+}
