+fn build_offset_directory(
+    truth: &[(BucketEntryPosition, u32)],
+    extent: u32,
+) -> OffsetDirectory {
+    let block_len = extent.div_ceil(OFFSET_BLOCK_SLOTS) as usize;
+    let mut block_counts = vec![0u16; block_len];
+    for (slot, _) in truth {
+        block_counts[(slot.raw() / OFFSET_BLOCK_SLOTS) as usize] += 1;
+    }
+    let mut group_counts = vec![0u16; block_len.div_ceil(OFFSET_GROUP_BLOCKS)];
+    for (block, count) in block_counts.iter().copied().enumerate() {
+        group_counts[block / OFFSET_GROUP_BLOCKS] += count;
+    }
+    assert_eq!(
+        block_counts.iter().copied().map(u32::from).sum::<u32>(),
+        truth.len() as u32
+    );
+    assert_eq!(
+        group_counts.iter().copied().map(u32::from).sum::<u32>(),
+        truth.len() as u32
+    );
+    OffsetDirectory {
+        block_counts,
+        group_counts,
+    }
+}
