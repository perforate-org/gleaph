+fn locate_fixed_block(
+    directory: &OffsetDirectory,
+    order: OutEdgeOrder,
+    mut ordinal: u32,
+) -> (usize, u32) {
+    let _scope = canbench_rs::bench_scope("offset_audit_fixed_block_directory_lookup");
+    match order {
+        OutEdgeOrder::Ascending => {
+            for (block, count) in directory.block_counts.iter().copied().enumerate() {
+                let count = u32::from(count);
+                if ordinal < count {
+                    return (block, ordinal);
+                }
+                ordinal -= count;
+            }
+        }
+        OutEdgeOrder::Descending => {
+            for (block, count) in directory.block_counts.iter().copied().enumerate().rev() {
+                let count = u32::from(count);
+                if ordinal < count {
+                    return (block, ordinal);
+                }
+                ordinal -= count;
+            }
+        }
+    }
+    panic!("live ordinal outside candidate directory")
+}
+
+fn locate_two_level_block(
+    directory: &OffsetDirectory,
+    order: OutEdgeOrder,
+    mut ordinal: u32,
+) -> (usize, u32) {
+    let group = match order {
+        OutEdgeOrder::Ascending => {
+            let mut found = None;
+            for (group, count) in directory.group_counts.iter().copied().enumerate() {
+                let count = u32::from(count);
+                if ordinal < count {
+                    found = Some(group);
+                    break;
+                }
+                ordinal -= count;
+            }
+            found
+        }
+        OutEdgeOrder::Descending => {
+            let mut found = None;
+            for (group, count) in directory.group_counts.iter().copied().enumerate().rev() {
+                let count = u32::from(count);
+                if ordinal < count {
+                    found = Some(group);
+                    break;
+                }
+                ordinal -= count;
+            }
+            found
+        }
     }
+    .expect("live ordinal outside candidate group directory");
+    let start = group * OFFSET_GROUP_BLOCKS;
+    let end = (start + OFFSET_GROUP_BLOCKS).min(directory.block_counts.len());
+    match order {
+        OutEdgeOrder::Ascending => {
+            for block in start..end {
+                let count = u32::from(directory.block_counts[block]);
+                if ordinal < count {
+                    return (block, ordinal);
+                }
+                ordinal -= count;
+            }
+        }
+        OutEdgeOrder::Descending => {
+            for block in (start..end).rev() {
+                let count = u32::from(directory.block_counts[block]);
+                if ordinal < count {
+                    return (block, ordinal);
+                }
+                ordinal -= count;
+            }
+        }
+    }
+    panic!("live ordinal outside candidate block directory")
 }
 
+fn locate_candidate_block(
+    directory: &OffsetDirectory,
+    candidate: OffsetCandidate,
+    order: OutEdgeOrder,
+    ordinal: u32,
+) -> (usize, u32) {
+    match candidate {
+        OffsetCandidate::FixedBlock => locate_fixed_block(directory, order, ordinal),
+        OffsetCandidate::TwoLevel => locate_two_level_block(directory, order, ordinal),
+    }
+}
