// Router → graph: enqueue and/or drain deferred maintenance after bulk ingest.
type BulkIngestFinalizeArgs = record {
  forward_vertices : vec nat32;
  target_shard_id : nat32;
  reverse_vertices : vec nat32;
  // `true`: enqueue span compaction then drain; `false`: drain-only retry.
  enqueue : bool;
};
// Progress from one bulk-ingest finalize call on a graph shard.
type BulkIngestFinalizeResult = record {
  queued_forward : nat32;
  processed_work_items : nat32;
  queued_reverse : nat32;
  remaining_queue_len : nat64;
  instruction_budget_exhausted : bool;
  instructions_used : nat64;
};
// Compact typed failure returned by Graph's canonical export control and data-plane methods.
//
// The public wire intentionally carries stable classifications instead of implementation detail
// strings. Graph Index uses these variants to distinguish exact-replay/lifecycle failures from
// malformed requests without parsing text; Graph keeps storage diagnostics in local logs.
type CanonicalExportError = variant {
  Storage;
  // The requested lifecycle operation is not valid for the current phase.
  InvalidPhase;
  ScopeConflict;
  UnsupportedInlineProfile;
  // The sequence is outside the admitted/captured range.
  SequenceOutOfRange;
  ScopeMismatch;
  // Removal would discard admitted work that has not reached the contiguous drain watermark.
  UnsafeRemoval;
  // The graph-index convergence proof does not match this Graph's captured seal watermark.
  NotConverged;
  // The sequence acknowledgement was not the next contiguous sequence.
  SequenceGap;
  InvalidRequest;
  ScopeNotFound;
  CursorMalformed;
  // The sequence was already acknowledged; callers must replay the original envelope only
  // through the graph-index exact-replay path, not by advancing this watermark again.
  SequenceReplay;
  InvalidScope;
  // The namespace is sealed and new build DML must be retried after the lifecycle advances.
  RetryableSealing;
  FactTooLarge : record { encoded_value_bytes : nat64 };
};
// Result of one bounded canonical export page.
type CanonicalExportPage = record {
  done : bool;
  // Opaque continuation.  `None` means this page reached the end of the selected source.
  next : opt blob;
  facts : vec CanonicalIndexableFact;
};
// Durable lifecycle phase for one Graph-owned physical export namespace.
//
// `Building` admits and sequences exact DML envelopes. `Sealing` captures the last admitted
// sequence under the old epoch and rejects new admissions retryably. `Active` is published only
// after the graph-index convergence proof matches the captured watermark. `Aborting` is never
// planner-visible and may be removed only after all admitted work is drained.
type CanonicalExportPhase = variant { Building; Active; Aborting; Sealing };
// Request for one bounded canonical export page.
//
// The cursor is an opaque Graph-owned token. It embeds this entire compact scope, and Graph
// validates those bindings so a token cannot be resumed under another graph, logical index,
// generation, epoch, or target.
type CanonicalExportRequest = record {
  graph_id : nat32;
  catalog_epoch : nat64;
  physical_index_id : nat64;
  cursor : opt blob;
  limit : nat32;
  target : CanonicalExportTarget;
  index_name_id : nat16;
};
// Durable scope frozen for one physical posting namespace.
//
// The stable Graph map is keyed by [`PhysicalIndexId`]; this value intentionally excludes that
// key and stores no cursor position.  A scope is immutable after first registration except for
// idempotent exact replay.
type CanonicalExportScope = record {
  graph_id : nat32;
  catalog_epoch : nat64;
  target : CanonicalExportTarget;
  // `Some` selects canonical edge INLINE bytes; `None` selects canonical edge sidecars.  This
  // field is ignored for vertex targets and must be absent there.
  inline : opt CanonicalInlineProjection;
  index_name_id : nat16;
};
// Graph-local status projection for Router and maintenance callers.
type CanonicalExportStatus = record {
  physical_index_id : nat64;
  admitted_through : nat64;
  epoch : nat64;
  scope : CanonicalExportScope;
  drained_through : nat64;
  phase : CanonicalExportPhase;
};
// One explicit logical property-index target.
type CanonicalExportTarget = variant {
  // An edge property identified by label, property, and the stable direction used by the
  // Router/index catalog (see ADR 0012).
  Edge : record {
    direction : EdgeIndexDirection;
    label_id : nat16;
    property_id : nat32;
  };
  // A vertex property identified by its Router-issued property id.
  Vertex : record { label_id : nat16; property_id : nat32 };
};
// One canonical indexable fact projected by Graph.
type CanonicalIndexableFact = variant {
  Edge : record {
    encoded_value : blob;
    label_id : nat16;
    property_id : nat32;
    slot_index : nat32;
    owner_vertex_id : nat32;
  };
  Vertex : record {
    vertex_id : nat32;
    encoded_value : blob;
    property_id : nat32;
  };
};
// Minimal Graph-owned projection needed to decode one fixed-width inline property value.
//
// `source_property_id` identifies the top-level inline slot in the edge schema.  For a scalar
// inline property it equals the target property id and `byte_offset` is zero.  For a struct leaf,
// it names the enclosing slot while `value_profile` describes the selected leaf byte range.
type CanonicalInlineProjection = record {
  byte_offset : nat16;
  source_property_id : nat32;
  value_profile : EdgeInlinePropertyProfile;
  source_profile : EdgeInlinePropertyProfile;
};
// Immutable identity of one uniqueness claim produced by a mutation.
//
// `ClaimId` carries **no element id**: the identity computed at Try (before the canonical element
// exists) is therefore byte-identical to the one stamped on the graph shard's `Acquire` receipt,
// so Try-time and commit-time identities always match (ADR 0030 §"Canonical owner and staged
// state"). `owner_element_id` is tracked separately on the reservation, not folded into identity.
type ClaimId = record {
  mutation_id : nat64;
  // Deterministic position of the claim within its mutation. First cut: the qualifying
  // `INSERT`'s plan position — exactly one constrained element per INSERT (ADR 0030 Scope). The
  // general `(plan_position, input_row_ordinal)` form belongs to the deferred multi-row protocol.
  claim_ordinal : nat32;
};
// One constrained `(vertex_label, property)` dispatched to the shard so a delete/remove can pin a
// `Release` for the freed value (ADR 0030 slice 5b).
//
// The ids are Router-interned and match the shard's stored vertex labels/property ids verbatim
// (the Router is the sole interner; it ships `ResolvedLabelTable`/`ResolvedPropertyTable` and the
// shard persists those same ids), so the shard matches a deleted vertex's labels/properties with
// no translation. `constraint_id` is the reservation-key constraint the freed value belongs to.
type ConstrainedPropertyDispatch = record {
  vertex_label_id : nat16;
  property_id : nat32;
  constraint_id : nat16;
};
// Logical edge-index direction represented by an indexed catalog membership.
//
// The variants mirror the GQL direction lattice. Graph uses the semantic inclusion helpers
// rather than interpreting raw bytes, so the Router remains the source of direction semantics.
type EdgeIndexDirection = variant {
  Any;
  OutgoingOrIncoming;
  IncomingOrUndirected;
  Outgoing;
  OutgoingOrUndirected;
  Undirected;
  Incoming;
};
// Semantic interpretation of stored edge-inline-property-bytes bytes.
type EdgeInlinePropertyEncoding = variant {
  F16;
  F32;
  F64;
  VectorF32 : record { dims : nat16 };
  RawI8;
  RawU8;
  RawI128;
  RawFixed32;
  RawFixed64;
  RawU128;
  RawI16;
  RawI32;
  RawI64;
  RawU16;
  RawU32;
  RawU64;
  // Opaque fixed-width inline property bytes; [`EdgeInlinePropertyProfile::byte_width`] may be any positive width.
  RawBytes;
};
// Label-level edge inline property bytes configuration.
type EdgeInlinePropertyProfile = record {
  encoding : EdgeInlinePropertyEncoding;
  byte_width : nat16;
};
// Per-label edge ordering policy resolved by the Router from the Graph Type
// declaration (ADR 0052 §1). The default is `Unordered`; `Insertion` labels
// preserve bucket-local insertion order. This is a resolved schema projection:
// Graph must not persist or re-derive it from physical state.
type EdgeOrderingPolicy = variant { Unordered; Insertion };
// Resume cursor: lexicographic [`EdgePropertyKey`] wire bytes (14 bytes on graph shard).
type EdgePostingBackfillArgs = record {
  max_entries : nat32;
  after_key : opt blob;
};
// Progress from one edge posting backfill batch.
type EdgePostingBackfillResult = record {
  entries_processed : nat32;
  postings_synced : nat32;
  done : bool;
  next_after_key : opt blob;
};
// Router → graph shard edge-property backfill request carrying the
// router-sourced indexed catalog for the operation (ADR 0023 D1/D5).
type EdgePropertyBackfillRequest = record {
  args : EdgePostingBackfillArgs;
  catalog : IndexedPropertyCatalog;
};
// Immutable identity of one effect within a mutation. `effect_ordinal` is deterministic across
// replays, so a re-executed segment re-emits the same `EffectId` (idempotent append).
type EffectId = record { mutation_id : nat64; effect_ordinal : nat32 };
// Progress from one embedding backfill batch on a graph shard.
type EmbeddingBackfillResult = record {
  vertices_processed : nat32;
  done : bool;
  embeddings_synced : nat32;
  next_vertex_id : nat32;
};
// Router → graph: execute a pre-built physical plan on a target shard.
type ExecutePlanArgs = record {
  // Router-issued idempotency key for update/DML execution.
  mutation_id : opt nat64;
  // Router-sourced indexed-property catalog for this operation (ADR 0023 D1/D3).
  // Consulted ephemerally by shard DML to decide which postings to maintain.
  indexed_properties : opt IndexedPropertyCatalog;
  plan_blob : blob;
  // Router-resolved label names referenced by the physical plan.
  resolved_labels : opt ResolvedLabelTable;
  mode : GqlExecutionMode;
  // Cross-shard uniqueness claims the shard must `Acquire` for the element it creates in this
  // segment (ADR 0030 slice 5). The Router has already reserved each `(constraint_id,
  // encoded_value)` via the no-`await` Try; the shard mints `ClaimId(mutation_id, claim_ordinal)`
  // and pins one `Acquire` receipt per claim so the Router can Confirm it. `None`/empty when the
  // operation touches no constrained property.
  unique_claims : opt vec UniqueClaimDispatch;
  target_shard_id : nat32;
  params_blob : blob;
  // Router-sourced indexed-embedding catalog for this operation (ADR 0031 Slice 3). Mirrors
  // `indexed_properties`: an ephemeral per-operation slice the shard consults to decide which
  // derived vector-embedding mutations to dispatch. In Slice 3 the Router builder is fail-closed
  // (always `None`/empty) until delete-spanning incarnation fencing activates dispatch, so
  // production shards never receive a non-empty catalog and vector sync stays inert.
  indexed_embeddings : opt IndexedEmbeddingCatalog;
  // Constrained `(vertex_label, property)` set the shard consults when this segment can delete or
  // remove a constrained element, so it can pin one `Release` receipt per freed value (ADR 0030
  // slice 5b). Like `indexed_properties` this is an ephemeral per-operation slice of the Router's
  // constraint catalog (no persistent shard-side catalog; ADR 0023). `None`/empty when the
  // operation cannot release a constrained value.
  constrained_properties : opt vec ConstrainedPropertyDispatch;
  // Constrained `(vertex_label, property)` set for `ShardLocalGlobal` constraints (ADR 0030 slice
  // 10). A delete/remove of such an element frees its value directly in the local unique table
  // (owner-matched), rather than pinning an outbox `Release`. `None`/empty when no constrained
  // property uses the `ShardLocalGlobal` strategy.
  local_constrained_properties : opt vec ConstrainedPropertyDispatch;
  // Router-resolved non-leading vector search hits for `PlanOp::Search` (ADR 0034 Slice 5).
  // Per-shard shard-local relation containing the bound vertex id and the user-visible scalar.
  // `None` for plans without a supported non-leading `SEARCH`.
  resolved_search_blob : opt blob;
  // `ShardLocalGlobal` fast-path claims (ADR 0030 slice 10). Unlike `unique_claims`, these were
  // **not** reserved through the Router (no Try/Acquire/Confirm). The single owning shard enforces
  // graph-wide uniqueness entirely in its local unique table: it preflights every claim against
  // the table and, only if all are clean, inserts them inside the same canonical write segment.
  // `None`/empty when no constrained property uses the `ShardLocalGlobal` strategy.
  local_unique_claims : opt vec UniqueClaimDispatch;
  // Router-resolved property names referenced by the physical plan.
  resolved_properties : opt ResolvedPropertyTable;
  // Per-graph key for ELEMENT_ID/path id encoding.
  element_id_encoding_key : blob;
  // When set, graph skips the first anchor `IndexScan` and binds these local vertex ids.
  seed_bindings_blob : opt blob;
};
// A bounded group of independent plan executions sent in one Router → Graph call.
//
// Each item retains its own mutation identity and execution payload. The Graph executes items
// independently; this type is an internal transport aggregation and does not make the group atomic.
type ExecutePlanBatchArgs = record {
  mode : ExecutePlanBatchMode;
  operations : vec ExecutePlanArgs;
};
type ExecutePlanBatchMode = variant { Dynamic; Fixed };
// Per-item outcomes for [`ExecutePlanBatchArgs`].
type ExecutePlanBatchResult = record {
  // Index of the first operation not attempted when Dynamic mode hit the Graph budget.
  next_index : opt nat32;
  results : vec Result_12;
};
type ExecutePlanResult = record {
  // Candid-encoded [`gleaph_gql_ic::IcWirePlanQueryResult`]; set on query shard execution.
  rows_blob : opt blob;
  row_count : nat64;
  // Forward out-adjacency hubs from a DML batch (router P3 auto-finalize hint).
  hot_forward_vertices : vec nat32;
};
// Router → graph: read a batch of mutation journal entries in one call.
type GetMutationJournalEntriesArgs = record { mutation_ids : vec nat64 };
// Graph → router: ordered optional journal entries for [`GetMutationJournalEntriesArgs`].
type GetMutationJournalEntriesResult = record {
  // Smallest mutation id not included because the Graph canister neared its instruction budget.
  // When present, the Router must issue a follow-up batch read for this and larger ids.
  next : opt nat64;
  entries : vec opt GraphMutationJournalEntryWire;
};
// Selects the IC call kind for a wired program/plan (must match the canister entrypoint).
type GqlExecutionMode = variant {
  // Write path (`gql_execute` / `execute_plan_update`).
  Update;
  // Read-only execution (`gql_query` / `execute_plan_query` / composite where needed).
  Query;
};
// Versioned internal plan-batch progress stored in a Graph journal entry.
type GraphBulkMutationProgress = variant { V1 : GraphBulkMutationProgressV1 };
type GraphBulkMutationProgressV1 = record {
  operation_row_counts : vec nat64;
  completed_count : nat32;
  operation_count : nat32;
};
// Arguments supplied by the registry (or installer) on first `init`.
type GraphInitArgs = record {
  shard_id : opt nat32;
  // Index canister for install-time federation wiring.
  //
  // Canister init cannot perform inter-canister calls, so deployments pass this after the
  // Router registry has been configured.
  index_canister : opt principal;
  // Router canister for federation (required together with `shard_id`).
  router_canister : opt principal;
  logical_graph_name : opt text;
};
// Versioned graph shard mutation idempotency journal entry (ADR 0015, ADR 0027, ADR 0057).
type GraphMutationJournalEntryWire = variant {
  V1 : GraphMutationJournalEntryWireV1;
};
type GraphMutationJournalEntryWireV1 = record {
  mutation_id : nat64;
  // Ordered local vertex allocations. `Some` is mandatory for ordered vertex/mixed entries;
  // edge-only and plan-execution entries must keep this `None` so the appendix remains absent.
  allocated_vertex_ids : opt vec nat32;
  emitted_delta_last_seq : opt nat64;
  // Internal plan-batch cursor: the first unexecuted operation.
  next_index : opt nat32;
  request_identity : GraphMutationRequestIdentityV1;
  // Internal plan-batch progress metadata.
  bulk_progress : opt GraphBulkMutationProgress;
  row_count : nat64;
  emitted_delta_first_seq : opt nat64;
  state : MutationJournalState;
  retirement : GraphMutationRetirementWireV1;
  // Forward hubs observed during DML, persisted so router recovery can still finalize.
  hot_forward_vertices : vec nat32;
};
// Graph-owned request identity for journal-first replay.
type GraphMutationRequestIdentityV1 = variant {
  // Order-sensitive identity for the ADR 0049 vertex bulk-placement envelope.
  OrderedVertexBatch : record {
    logical_item_count : nat32;
    canonical_encoding_version : nat16;
    graph_request_fingerprint : blob;
  };
  // Order-sensitive identity for the ADR 0049 edge batch envelope.
  OrderedEdgeBatch : record {
    logical_item_count : nat32;
    canonical_encoding_version : nat16;
    graph_request_fingerprint : blob;
  };
  // Order-sensitive identity for the mixed vertex/edge two-phase envelope.
  OrderedMixedBatch : record {
    logical_edge_count : nat32;
    canonical_encoding_version : nat16;
    graph_request_fingerprint : blob;
    logical_vertex_count : nat32;
    logical_operation_count : nat32;
  };
  // Existing scalar and legacy/bulk plan execution identity.
  PlanExecution;
};
// Wire projection of [`GraphMutationRetirementV1`] without the stable timestamp.
type GraphMutationRetirementWireV1 = variant { NotApplicable; Active; Retired };
// Durable aggregate receipt returned by a completed ordered Graph edge batch.
type GraphOrderedEdgeBatchReceiptV1 = record {
  logical_edge_count : nat64;
  emitted_delta_last_seq : opt nat64;
  emitted_delta_first_seq : opt nat64;
  hot_forward_vertices : vec nat32;
};
// Graph-owned canonical response for the ordered edge-batch endpoint.
type GraphOrderedEdgeBatchResult = variant {
  V1 : GraphOrderedEdgeBatchResultV1;
};
type GraphOrderedEdgeBatchResultV1 = variant {
  MutationRetired : record {
    mutation_id : nat64;
    graph_request_fingerprint : blob;
  };
  Completed : GraphOrderedEdgeBatchReceiptV1;
};
// Durable aggregate receipt returned by a completed mixed Graph batch.
type GraphOrderedMixedBatchReceiptV1 = record {
  logical_edge_count : nat64;
  // Vertex IDs in request-local vertex-operation ordinal order.
  allocated_vertex_ids : vec nat32;
  emitted_delta_last_seq : opt nat64;
  emitted_delta_first_seq : opt nat64;
  logical_vertex_count : nat64;
  logical_operation_count : nat64;
  hot_forward_vertices : vec nat32;
};
type GraphOrderedMixedBatchResult = variant {
  V1 : GraphOrderedMixedBatchResultV1;
};
type GraphOrderedMixedBatchResultV1 = variant {
  MutationRetired : record {
    mutation_id : nat64;
    graph_request_fingerprint : blob;
  };
  Completed : GraphOrderedMixedBatchReceiptV1;
};
// Durable aggregate receipt returned by a completed ordered Graph vertex batch.
type GraphOrderedVertexBatchReceiptV1 = record {
  // Vertex IDs in request-local vertex-operation ordinal order.
  allocated_vertex_ids : vec nat32;
  emitted_delta_last_seq : opt nat64;
  emitted_delta_first_seq : opt nat64;
  logical_vertex_count : nat64;
  hot_forward_vertices : vec nat32;
};
type GraphOrderedVertexBatchResult = variant {
  V1 : GraphOrderedVertexBatchResultV1;
};
type GraphOrderedVertexBatchResultV1 = variant {
  MutationRetired : record {
    mutation_id : nat64;
    graph_request_fingerprint : blob;
  };
  Completed : GraphOrderedVertexBatchReceiptV1;
};
// Progress of one bounded build-DML drain step.
//
// `converged` is true only when no build-DML entries remain for the namespace AND the scope
// record's `drained_through` has reached its `admitted_through` watermark.
type IndexBuildOutboxDrainProgress = record {
  remaining : nat64;
  converged : bool;
  drained : nat32;
};
// Bounded Graph-side drain of one physical namespace's build-DML outbox entries.
type IndexBuildOutboxDrainRequest = record {
  physical_index_id : nat64;
  max_entries : nat32;
};
// Seal registration/drain status returned to Router.
type IndexBuildSealStatus = record {
  base_complete : bool;
  watermarks : vec IndexBuildShardWatermark;
  seal_catalog_epoch : nat64;
};
// Durable old-epoch drain proof for one target shard.
type IndexBuildShardWatermark = record {
  admitted_through : nat64;
  shard_id : nat32;
  drained_through : nat64;
};
// Lifecycle phase carried with a Router-owned indexed-catalog membership.
//
// Graph persists this phase with pending and repair work so a future lifecycle-aware
// dispatcher can route Building/Sealing work to the build protocol. The ordinary
// posting path is valid only for Active memberships.
type IndexMaintenancePhase = variant { Building; Active; Sealing };
// Graph-side snapshot of durable derived-index work not yet delivered to graph-index.
//
// The social-demo seeding orchestrator needs one observable "the index caught up" signal
// before dispatching dependent edge waves, whose `MATCH` anchors resolve through
// graph-index property postings. The existing [`crate::plan_exec::MutationId`] watermark
// (`index_pending_min_mutation_id`) covers only the repair journal (failed-flush
// re-application); the durable first-delivery outbox is a separate backlog that can also
// pin convergence, so this snapshot reports both queues and a derived `converged` flag.
type IndexSyncStatus = record {
  // Failed-flush ops persisted in the repair journal awaiting re-application.
  repair_journal_len : nat64;
  // `derived_index_outbox_len == 0 && repair_journal_len == 0`.
  converged : bool;
  // Derived-index ops still in the durable first-delivery outbox (never yet delivered).
  derived_index_outbox_len : nat64;
};
// One edge index membership `(label, property, direction)` in [`IndexedPropertyCatalog`].
type IndexedEdgeMembership = record {
  direction : EdgeIndexDirection;
  catalog_epoch : nat64;
  physical_index_id : nat64;
  // Empty for a scalar/top-level edge property; the canonical dotted path for an inline
  // struct leaf otherwise (for example, `stats.score`).
  field_path : text;
  label_id : nat16;
  property_id : nat32;
  phase : IndexMaintenancePhase;
};
// Router-sourced snapshot of which embedding names are indexed (mirrors `IndexedPropertyCatalog`).
type IndexedEmbeddingCatalog = record { embeddings : vec IndexedEmbeddingSpec };
// One indexed embedding definition supplied ephemerally by the Router (Slice 3).
//
// Slice 2 defines the type only; the graph never persists an indexed-embedding registry. A
// dispatch with no installed catalog skips vector sync entirely (production), while tests inject
// a catalog via the embedding catalog context.
type IndexedEmbeddingSpec = record {
  metric : VectorMetric;
  encoding : VectorEncoding;
  dims : nat16;
  kind : VectorIndexKind;
  embedding_name_id : nat16;
  index_id : nat32;
};
// Router-sourced snapshot of which properties are indexed (ADR 0023 D1/D3).
//
// The router (definitions SSOT) supplies this per operation so the graph shard
// never persists derived index state. It is consulted ephemerally (set at the
// start of an operation, cleared at the end) and is therefore immune to the
// upgrade boundary that made the former shard-local registry stale.
type IndexedPropertyCatalog = record {
  vertex_indexes : vec IndexedVertexMembership;
  edge_indexes : vec IndexedEdgeMembership;
};
// One vertex index membership in the Router-sourced operation catalog.
//
// The physical namespace is allocated and owned by Router. Graph may cache this projection for
// the operation, but it must never derive or substitute a namespace locally.
type IndexedVertexMembership = record {
  catalog_epoch : nat64;
  physical_index_id : nat64;
  label_id : nat16;
  property_id : nat32;
  phase : IndexMaintenancePhase;
};
// Per-label live count changes emitted by graph shard DML (ADR 0015).
type LabelStatsDelta = record {
  edge : vec record { nat16; int64 };
  vertex : vec record { nat16; int64 };
};
// Ordered label stats delta appended by graph shard DML (ADR 0015).
type LabelStatsDeltaEventWire = record {
  mutation_id : nat64;
  shard_event_seq : nat64;
  label_stats_delta : LabelStatsDelta;
};
// Graph-local mutation journal state (ADR 0015).
//
// This is a *shard-local* idempotency outcome, not a cross-canister status. `Completed`
// here means the shard-local canonical mutation outcome is durable and replayable; it
// does **not** imply that derived projections (graph-index postings, Router label stats)
// have converged. Cross-canister convergence is tracked separately by Router's
// [`MutationLifecyclePhase`] (ADR 0029).
type MutationJournalState = variant { Completed; Incomplete };
// Execution mode for an ordered batch Graph request (ADR 0060).
//
// The mode is a transport property carried on the args envelope, never inside the fingerprinted
// request, so the same chunk content has the same fingerprint regardless of mode.
type OrderedBatchExecutionModeV1 = variant {
  // Commit the entire request atomically or fail (atomic-insert contract).
  Atomic;
  // Commit the largest budget-fitting prefix as one atomic journal entry and return the
  // committed count (bulk-load chunk execution; the committed prefix is the chunk).
  Resumable;
};
// Immutable Graph execution envelope. The transmitted fingerprint is integrity metadata; the
// Graph recomputes it from `request` before journal lookup.
type OrderedEdgeBatchGraphArgs = variant { V1 : OrderedEdgeBatchGraphArgsV1 };
type OrderedEdgeBatchGraphArgsV1 = record {
  mutation_id : nat64;
  graph_request_fingerprint : blob;
  execution_mode : OrderedBatchExecutionModeV1;
  request : OrderedEdgeBatchGraphRequest;
  // Router-sourced indexed-property catalog scoped to the edge label/property pairs this batch
  // writes (ADR 0023 D1/D3). Transport metadata like [`Self::execution_mode`]: carried outside
  // the fingerprinted request, so catalog changes do not perturb replay identity.
  indexed_property_catalog : IndexedPropertyCatalog;
};
// One logical edge in the immutable Router → Graph ordered request.
type OrderedEdgeBatchGraphItemV1 = record {
  directed : bool;
  inline_property_bytes : blob;
  resolved_initial_edge_properties : vec ResolvedOrderedEdgePropertyV1;
  catalog_edge_label_id : opt nat16;
  target_local_vertex_id : nat32;
  source_local_vertex_id : nat32;
};
// Versioned immutable Router → Graph canonical request for ADR 0049.
type OrderedEdgeBatchGraphRequest = variant {
  V1 : OrderedEdgeBatchGraphRequestV1;
};
type OrderedEdgeBatchGraphRequestV1 = record {
  graph_id : nat32;
  resolved_labels : ResolvedLabelTable;
  target_shard_id : nat32;
  resolved_properties : ResolvedPropertyTable;
  items : vec OrderedEdgeBatchGraphItemV1;
  target_graph_canister : principal;
};
// Internal execution envelope for the mixed two-phase path. Execution is not
// active yet; this type exists so Router and Graph can agree on the immutable
// request before the durable phase/journal implementation lands.
type OrderedMixedBatchGraphArgs = variant { V1 : OrderedMixedBatchGraphArgsV1 };
type OrderedMixedBatchGraphArgsV1 = record {
  mutation_id : nat64;
  graph_request_fingerprint : blob;
  execution_mode : OrderedBatchExecutionModeV1;
  request : OrderedMixedBatchGraphRequest;
  // Router-sourced indexed-property catalog scoped to the vertex properties and edge
  // `(label_id, property_id)` scopes this batch writes (ADR 0023 D1/D3). Transport metadata
  // like [`Self::execution_mode`]: carried outside the fingerprinted request, so catalog
  // changes do not perturb replay identity.
  indexed_property_catalog : IndexedPropertyCatalog;
};
// Versioned Graph envelope for a mixed vertex/edge batch.
type OrderedMixedBatchGraphRequest = variant {
  V1 : OrderedMixedBatchGraphRequestV1;
};
type OrderedMixedBatchGraphRequestV1 = record {
  graph_id : nat32;
  resolved_labels : ResolvedLabelTable;
  target_shard_id : nat32;
  operations : vec OrderedMixedGraphOperationV1;
  resolved_properties : ResolvedPropertyTable;
  target_graph_canister : principal;
};
// One logical edge in the Graph-owned mixed request.
type OrderedMixedGraphEdgeItemV1 = record {
  source : OrderedMixedGraphEndpointV1;
  directed : bool;
  inline_property_bytes : blob;
  target : OrderedMixedGraphEndpointV1;
  resolved_initial_edge_properties : vec ResolvedOrderedEdgePropertyV1;
  catalog_edge_label_id : opt nat16;
};
// Endpoint of an edge in the request-local mixed vertex/edge operation table.
//
// `NewVertexOrdinal` is an ordinal among vertex operations, not an ordinal in the
// mixed operation array. Graph allocates the vertex phase first and resolves this
// reference before admitting the edge phase.
type OrderedMixedGraphEndpointV1 = variant {
  NewVertexOrdinal : nat32;
  Existing : nat32;
};
// Input-order-preserving mixed operation. The array order remains the public
// logical order; Graph uses the variant to derive the two execution phases.
type OrderedMixedGraphOperationV1 = variant {
  Edge : OrderedMixedGraphEdgeItemV1;
  Vertex : OrderedVertexBatchGraphItemV1;
};
// Graph-owned acknowledgement for mixed ordered mutation retirement.
type OrderedMixedMutationRetirementAck = variant {
  V1 : OrderedMixedMutationRetirementAckV1;
};
type OrderedMixedMutationRetirementAckV1 = record {
  mutation_id : nat64;
  receipt : GraphOrderedMixedBatchReceiptV1;
  graph_request_fingerprint : blob;
};
// Graph-owned acknowledgement for the internal Router-to-Graph retirement call.
type OrderedMutationRetirementAck = variant {
  V1 : OrderedMutationRetirementAckV1;
};
type OrderedMutationRetirementAckV1 = record {
  mutation_id : nat64;
  receipt : GraphOrderedEdgeBatchReceiptV1;
  graph_request_fingerprint : blob;
};
// Arguments for the internal Router-to-Graph ordered retirement call.
type OrderedMutationRetirementArgs = variant {
  V1 : OrderedMutationRetirementArgsV1;
};
type OrderedMutationRetirementArgsV1 = record {
  mutation_id : nat64;
  graph_request_fingerprint : blob;
};
// Internal Graph execution envelope for the vertex-only bulk-placement slice.
type OrderedVertexBatchGraphArgs = variant {
  V1 : OrderedVertexBatchGraphArgsV1;
};
type OrderedVertexBatchGraphArgsV1 = record {
  mutation_id : nat64;
  graph_request_fingerprint : blob;
  execution_mode : OrderedBatchExecutionModeV1;
  request : OrderedVertexBatchGraphRequest;
  // Router-sourced indexed-property catalog scoped to the properties this batch writes (ADR
  // 0023 D1/D3). Transport metadata like [`Self::execution_mode`]: carried outside the
  // fingerprinted request, so catalog changes do not perturb replay identity.
  indexed_property_catalog : IndexedPropertyCatalog;
};
// One logical vertex in the versioned Router → Graph vertex request.
type OrderedVertexBatchGraphItemV1 = record {
  resolved_initial_properties : vec ResolvedOrderedEdgePropertyV1;
  resolved_vertex_labels : vec nat16;
};
// Versioned immutable Router → Graph canonical request for vertex bulk placement.
type OrderedVertexBatchGraphRequest = variant {
  V1 : OrderedVertexBatchGraphRequestV1;
};
type OrderedVertexBatchGraphRequestV1 = record {
  graph_id : nat32;
  resolved_labels : ResolvedLabelTable;
  target_shard_id : nat32;
  resolved_properties : ResolvedPropertyTable;
  items : vec OrderedVertexBatchGraphItemV1;
  target_graph_canister : principal;
};
// Graph-owned acknowledgement for vertex-only ordered mutation retirement.
type OrderedVertexMutationRetirementAck = variant {
  V1 : OrderedVertexMutationRetirementAckV1;
};
type OrderedVertexMutationRetirementAckV1 = record {
  mutation_id : nat64;
  receipt : GraphOrderedVertexBatchReceiptV1;
  graph_request_fingerprint : blob;
};
// One batch of vertex-local posting replay from canonical shard state.
type PostingBackfillArgs = record {
  max_vertices : nat32;
  start_vertex_id : nat32;
};
// Progress from one posting backfill batch on a graph shard.
type PostingBackfillResult = record {
  postings_synced : nat32;
  vertices_processed : nat32;
  done : bool;
  next_vertex_id : nat32;
};
type ResolvedEdgeLabel = record {
  id : nat16;
  name : text;
  // Router-owned logical schema (ADR 0008). Default `no_inline_property` when omitted on legacy wire.
  inline_property_profile : EdgeInlinePropertyProfile;
  // Per-label ordering policy resolved by the Router from the Graph Type declaration
  // (ADR 0052 §1/§4). `Unordered` is the default; `Insertion` declares that the
  // bucket-local live order is the semantic insertion order.
  ordering : EdgeOrderingPolicy;
  // Router-derived named inline property schema for this concrete edge label (ADR 0034 Slices 21/24/25).
  // `None` for labels with no named inline slot; otherwise a scalar or struct projection.
  // Graph receives this as a plan-scoped projection and must not persist or infer it.
  inline_schema : opt ResolvedInlineSchema;
};
// Router-derived resolved schema for the named inline edge property of one concrete label.
//
// Replaces the ambiguous `Option<PropertyId>` parallel wire state with one explicit enum:
// - `None`: this label has no named inline property.
// - `Scalar { property_id }`: one fixed-width scalar inline property.
// - `Struct { property_id, fields }`: one fixed-size inline STRUCT, declaration-ordered.
//
// Graph receives this as a plan-scoped projection and must not persist or infer it.
type ResolvedInlineSchema = variant {
  struct : record {
    fields : vec ResolvedInlineStructField;
    property_id : nat32;
  };
  scalar : record { property_id : nat32 };
};
// Physical field descriptor for one fixed-size inline edge STRUCT slot.
//
// Router derives this from the canonical declaration order; Graph receives it as a plan-scoped
// projection and must not persist or infer it. Each descriptor carries only the data Graph needs
// to validate and decode the inline property bytes slice: field name, byte offset, and exact scalar profile.
type ResolvedInlineStructField = record {
  byte_offset : nat16;
  name : text;
  profile : EdgeInlinePropertyProfile;
};
type ResolvedLabelTable = record {
  edge : vec ResolvedEdgeLabel;
  vertex : vec ResolvedVertexLabel;
};
// Router-resolved initial property assignment for one logical ordered edge.
type ResolvedOrderedEdgePropertyV1 = record {
  value : blob;
  property_id : nat32;
};
type ResolvedProperty = record { id : nat32; name : text };
type ResolvedPropertyTable = record { properties : vec ResolvedProperty };
type ResolvedVertexLabel = record { id : nat16; name : text };
type Result = variant {
  Ok : CanonicalExportStatus;
  Err : CanonicalExportError;
};
type Result_1 = variant {
  Ok : IndexBuildOutboxDrainProgress;
  Err : CanonicalExportError;
};
type Result_10 = variant { Ok : GraphOrderedMixedBatchResult; Err : text };
type Result_11 = variant { Ok : GraphOrderedVertexBatchResult; Err : text };
type Result_12 = variant { Ok : ExecutePlanResult; Err : text };
type Result_13 = variant { Ok : ExecutePlanBatchResult; Err : text };
type Result_14 = variant { Ok : BulkIngestFinalizeResult; Err : text };
type Result_15 = variant {
  Ok : CanonicalExportPage;
  Err : CanonicalExportError;
};
type Result_16 = variant { Ok : OrderedMixedMutationRetirementAck; Err : text };
type Result_17 = variant { Ok : OrderedMutationRetirementAck; Err : text };
type Result_18 = variant {
  Ok : OrderedVertexMutationRetirementAck;
  Err : text;
};
type Result_2 = variant { Ok : VertexEmbeddingIngestionResult; Err : text };
type Result_3 = variant { Ok : vec Result_2; Err : text };
type Result_4 = variant { Ok; Err : CanonicalExportError };
type Result_5 = variant { Ok; Err : text };
type Result_6 = variant { Ok : EdgePostingBackfillResult; Err : text };
type Result_7 = variant { Ok : PostingBackfillResult; Err : text };
type Result_8 = variant { Ok : EmbeddingBackfillResult; Err : text };
type Result_9 = variant { Ok : GraphOrderedEdgeBatchResult; Err : text };
// Logical size of one named virtual stable-memory region owned by a canister.
//
// This excludes `MemoryManager` bucket rounding and is therefore not the
// canister's physical stable-memory allocation.
type StableMemoryRegionStats = record {
  slack_pages : nat64;
  logical_pages : nat64;
  logical_bytes : nat64;
  name : text;
  allocated_pages : nat64;
  memory_id : nat8;
  bucket_pages : nat16;
};
// Stable-memory inventory for one canister.
type StableMemoryStats = record {
  regions : vec StableMemoryRegionStats;
  bucket_pages : nat16;
  estimated_allocated_pages : nat64;
  estimated_allocated_bytes : nat64;
  logical_total_pages : nat64;
  logical_total_bytes : nat64;
};
// Evidence that a claim's `Acquire` is pinned: the matching effect's `EffectId` (so the Router can
// ack *that* effect after Confirm — `claim_ordinal` and `effect_ordinal` are distinct concepts and
// neither derives the other) plus the canonical `owner_element_id`.
type UniqueAcquireEvidence = record {
  owner_element_id : blob;
  effect_id : EffectId;
};
// Replicated commit-proof answer for one claim (Router reclaim proof, ADR 0030 §Timeout).
// `acquire` is `Some` iff a matching `Acquire` effect is pinned on this shard.
type UniqueAcquireProof = record {
  claim_id : ClaimId;
  acquire : opt UniqueAcquireEvidence;
};
// One cross-shard uniqueness claim dispatched to the shard for `Acquire` (ADR 0030 slice 5).
//
// `claim_ordinal` is the claim's deterministic position within the mutation; combined with the
// envelope's `mutation_id` it yields the immutable `ClaimId` the Router reserved. `encoded_value`
// is the canonical key the Router already validated and reserved, carried verbatim so the shard's
// pinned receipt and the Router's reservation reference identical bytes.
type UniqueClaimDispatch = record {
  encoded_value : blob;
  constraint_id : nat16;
  claim_ordinal : nat32;
};
// Direction of a unique effect. `Acquire` claims a value for an element; `Release` frees the value
// a (possibly different) mutation previously held.
type UniqueEffectOp = variant { Release; Acquire };
// One pinned unique-effect receipt.
//
// Matching rules (ADR 0030): an `Acquire` is matched by **`claim_id`** (so an old acked-but-unpruned
// `Acquire` for a prior claim on the same value is never mistaken for newer commit evidence); a
// `Release` is matched by **`owner_element_id`** (the producing mutation differs from the original
// `Acquire`, so its `claim_id` is audit-only / `None`).
type UniqueEffectReceipt = record {
  op : UniqueEffectOp;
  // Canonical element that owns the value: the exact encoded element-id bytes (a vertex id is 8
  // bytes, an edge id 12). Stored variable-length rather than a fixed buffer so different element
  // kinds never collide under an opaque padding convention; the Router treats it as an opaque tag
  // (`Acquire` Confirm stamps it; `Release` matches on it).
  owner_element_id : blob;
  // `Some` for `Acquire` (the reserving claim); audit-only / `None` for `Release`.
  claim_id : opt ClaimId;
  effect_id : EffectId;
  encoded_value : blob;
  constraint_id : nat16;
};
// Encoding of a stored vertex embedding.
//
// Only fixed-dimension `F32` is supported in the first slice. New variants (`F16`, `I8`) must
// update every exhaustive `match` on this enum, which is the intended compile-time gate before
// an `UnsupportedEncoding`-style runtime branch is introduced.
type VectorEncoding = variant {
  // IEEE-754 little-endian `f32` components; byte width is `dims * 4`.
  F32;
};
// Physical index structure for a derived vector index.
//
// Slice 2 standardizes on `IvfFlat` operated in its degenerate form (`nlist = 1`,
// `partition_id = 0`, no centroids). There is intentionally no separate `Flat` kind: the
// baseline exact scan landed in Slice 4+ is `IvfFlat` with one partition.
type VectorIndexKind = variant {
  // Inverted-file flat: centroid-pruned exact rerank. Degenerate `nlist = 1` in Slice 2.
  IvfFlat;
};
// Distance/similarity metric for vector scoring.
type VectorMetric = variant {
  // Squared Euclidean distance (no square root); smaller is nearer.
  L2Squared;
  // Cosine similarity expressed internally as `1 - similarity`; smaller is nearer.
  // User-facing score is `1 - raw`; this metric has no natural distance.
  Cosine;
};
// Router → graph shard vertex-embedding backfill request carrying the router-sourced indexed
// embedding catalog for the operation.
type VertexEmbeddingBackfillRequest = record {
  args : PostingBackfillArgs;
  catalog : IndexedEmbeddingCatalog;
};
// Router → graph shard: one bounded canonical vertex-embedding ingestion request.
//
// The Router resolves the opaque graph-scoped vertex id and the embedding definition before
// dispatching; the graph shard only sees the local vertex id and the authoritative
// [`IndexedEmbeddingSpec`]. The canonical byte encoding happens inside the graph-owned write
// boundary.
type VertexEmbeddingIngestionArgs = record {
  local_vertex_id : nat32;
  spec : IndexedEmbeddingSpec;
  values : vec float32;
};
// Result of [`VertexEmbeddingIngestionArgs`].
//
// `embedding_version` is the canonical `StoredEmbedding.version` after the write. The
// `projection_outcome` distinguishes a fully applied derived projection from a durable deferred
// repair so callers do not blindly retry a canonical write that has already committed.
type VertexEmbeddingIngestionResult = record {
  embedding_version : nat64;
  projection_outcome : VertexEmbeddingProjectionOutcome;
};
// Outcome of the derived vector-index projection after a canonical embedding commit.
type VertexEmbeddingProjectionOutcome = variant {
  // The derived vector canister was unreachable or not yet attached; the full idempotent batch
  // was durably journaled for repair and will converge automatically.
  DeferredForRepair;
  // The derived vector canister accepted the upsert in this message.
  Applied;
};
// Router → graph shard vertex-property backfill request carrying the
// router-sourced indexed catalog for the operation (ADR 0023 D1/D5).
type VertexPropertyBackfillRequest = record {
  args : PostingBackfillArgs;
  catalog : IndexedPropertyCatalog;
};
service : (GraphInitArgs) -> {
  ack_label_stats_deltas_through : (nat64) -> ();
  // Router → graph: per-effect ack (unpin) of unique effects after the Router has durably applied
  // them (ADR 0030).
  ack_unique_effects : (vec EffectId) -> ();
  // Router → graph: mark one export scope `Aborting` under its original registration identity.
  admin_abort_index_export_scope : (nat64, CanonicalExportScope) -> (Result);
  // Router → graph: publish one export scope `Active` after graph-index convergence.
  admin_activate_index_export_scope : (nat64, IndexBuildSealStatus) -> (Result);
  // Router → graph: bounded drain of one namespace's build-DML outbox entries to graph-index.
  admin_drain_index_build_outbox : (IndexBuildOutboxDrainRequest) -> (Result_1);
  // Router → graph: exact durable status for one export scope.
  admin_index_export_scope_status : (nat64) -> (Result) query;
  // Router → graph (plan 0048): bounded canonical vertex-embedding ingestion.
  admin_ingest_vertex_embedding : (VertexEmbeddingIngestionArgs) -> (Result_2);
  // Router → graph (plan 0048 extension): bounded batch canonical vertex-embedding ingestion.
  admin_ingest_vertex_embedding_batch : (vec VertexEmbeddingIngestionArgs) -> (
      Result_3,
    );
  // Router → graph: freeze one immutable canonical export scope for a physical index namespace.
  admin_register_index_export_scope : (nat64, CanonicalExportScope) -> (
      Result_4,
    );
  // Router → graph: remove an export scope under its complete current owner contract.
  admin_remove_index_export_scope : (nat64, CanonicalExportScope) -> (Result_4);
  // Router → graph: seal one export scope at a fresh catalog epoch.
  admin_seal_index_export_scope : (nat64, CanonicalExportScope, nat64) -> (
      Result,
    );
  // Router → graph (ADR 0031 Slice 4): set this shard's local derived vector-index target as the
  // first step of the Router-driven vector attach handshake.
  admin_set_vector_index_canister : (principal) -> (Result_5);
  // Router → graph: operator-only physical stable-memory inventory.
  admin_stable_memory_stats : () -> (StableMemoryStats) query;
  backfill_edge_property_postings : (EdgePropertyBackfillRequest) -> (Result_6);
  backfill_label_postings : (PostingBackfillArgs) -> (Result_7);
  backfill_vertex_embeddings : (VertexEmbeddingBackfillRequest) -> (Result_8);
  backfill_vertex_property_postings : (VertexPropertyBackfillRequest) -> (
      Result_7,
    );
  // Router → graph: journal-first ordered edge batch execution (ADR 0049).
  execute_ordered_edge_batch : (OrderedEdgeBatchGraphArgs) -> (Result_9);
  // Router → graph: journal-first mixed vertex/edge batch execution (ADR 0049).
  execute_ordered_mixed_batch : (OrderedMixedBatchGraphArgs) -> (Result_10);
  // Router → graph: journal-first ordered vertex bulk placement (ADR 0049).
  execute_ordered_vertex_batch : (OrderedVertexBatchGraphArgs) -> (Result_11);
  // Router → graph: read-only plan wire (may call index / federated expand).
  execute_plan_query : (ExecutePlanArgs) -> (Result_12) composite_query;
  // Router → graph: plan wire with DML.
  execute_plan_update : (ExecutePlanArgs) -> (Result_12);
  execute_plan_update_batch : (ExecutePlanBatchArgs) -> (Result_13);
  finalize_bulk_ingest : (BulkIngestFinalizeArgs) -> (Result_14);
  get_mutation_journal_entries : (GetMutationJournalEntriesArgs) -> (
      GetMutationJournalEntriesResult,
    ) query;
  get_mutation_journal_entry : (nat64) -> (
      opt GraphMutationJournalEntryWire,
    ) query;
  // Graph-index → graph: read one bounded page from canonical Graph storage.
  index_export_page : (CanonicalExportRequest) -> (Result_15);
  // Router → graph: smallest tracked mutation id with unapplied index postings, or
  // `None` when index work has drained (ADR 0029 Phase 2 read-your-writes barrier).
  index_pending_min_mutation_id : () -> (opt nat64) query;
  // Router → graph: index convergence snapshot (durable first-delivery outbox +
  // failed-flush repair journal). Seeding orchestration polls `converged` before
  // dispatching index-dependent edge waves.
  index_sync_status : () -> (IndexSyncStatus) query;
  list_pending_label_stats_deltas : (nat64, nat32) -> (
      vec LabelStatsDeltaEventWire,
    ) query;
  // Router → graph: bounded purge of a `ShardLocalGlobal` constraint's local unique entries for the
  // DROP drain, returning whether the constraint's local table is now empty (ADR 0030 slice 10). An
  // update so the purge is replicated.
  purge_local_unique_constraint : (nat16, nat32) -> (bool);
  // Router → graph (replicated read): per-claim `Acquire` commit proof from the pinned unique-effect
  // outbox (ADR 0030). An `update` so the answer is replicated/certified.
  read_unique_effect_proof : (vec ClaimId) -> (vec UniqueAcquireProof);
  // Router → graph (replicated read): one page of all of a mutation's pinned effects (`Acquire` and
  // `Release`), paged by `effect_ordinal` cursor, for the Router's unified slice-6 effect recovery
  // (Driver 2). An `update` so the answer is replicated/certified.
  read_unique_mutation_effects : (nat64, opt nat32, nat32) -> (
      vec UniqueEffectReceipt,
    );
  // Router → graph (replicated read): one page of a mutation's pinned `Release` effects, reconciled
  // by the Router per `owner_element_id` and paged by `effect_ordinal` cursor (ADR 0030 slice 5b). An
  // `update` so the answer is replicated/certified.
  read_unique_release_effects : (nat64, opt nat32, nat32) -> (
      vec UniqueEffectReceipt,
    );
  // Router → graph: fingerprint-bound ordered mixed mutation retirement (ADR 0049).
  retire_ordered_mixed_mutation : (OrderedMutationRetirementArgs) -> (
      Result_16,
    );
  // Router → graph: fingerprint-bound ordered mutation retirement (ADR 0049).
  retire_ordered_mutation : (OrderedMutationRetirementArgs) -> (Result_17);
  // Router → graph: retire an exact ordered vertex mutation after projection convergence.
  retire_ordered_vertex_mutation : (OrderedMutationRetirementArgs) -> (
      Result_18,
    );
}
