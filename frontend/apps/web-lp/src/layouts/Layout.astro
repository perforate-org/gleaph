---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Gleaph', description = 'Gleaph — a federated graph query platform on the Internet Computer.' } =
  Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-background text-foreground antialiased">
    <slot />
  </body>
</html>
