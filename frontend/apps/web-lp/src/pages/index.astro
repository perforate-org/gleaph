          <p class="hero-claim heading-4">One engine. Every way to query.</p>

          <p class="lede body-7">Query in natural language or use the query language you know.</p>

          <ul class="hero-langs" aria-label="Query languages">
            {languages.map((language) => (
              <li class={`is-${language.status}`}>
                <span class="lang-name title-4">{language.name}</span>
                <span class="lang-status caption-5">{statusLabel[language.status]}</span>
              </li>
            ))}
          </ul>

          <p class="lede body-7">
            Unified graph, vector and full-text search for dapps on the&#32;
            <a class="inline-link" href="https://internetcomputer.org/" target="_blank" rel="noreferrer"
              >Internet Computer</a
            >. Native on-chain intelligence, with every caller’s grants checked inside the plan.
          </p>

          <div class="hero-actions">
            <a class="btn primary button-md" href={links.quickstart} target="_blank" rel="noreferrer">
              Run the quickstart
            </a>
            <a class="text-link caption-1" href="#how-it-runs">See how a query runs</a>
          </div>

          <div class="hero-cmd">
            <code class="body-6"><span class="cmd-prompt" aria-hidden="true">$</span>git clone https://github.com/perforate-org/gleaph</code>
            <button
              class="cmd-copy"
              type="button"
              data-copy="git clone https://github.com/perforate-org/gleaph"
              aria-label="Copy the command"
            >
              <span class="copy-idle"><Icon name="copy" /></span>
              <span class="copy-done"><Icon name="check" /></span>
            </button>
          </div>
        </section>

        <section class="home-stage" aria-labelledby="stage-label">
          <h2 class="visually-hidden" id="stage-label">One question in four languages, one plan</h2>

          <div class="stage">
            <div class="stage-bar">
              <div class="show-tabs" role="tablist" aria-label="Query language">
                <span class="slide-ind" aria-hidden="true"></span>
                {languages.map((language) => (
                  <button
                    class="show-tab caption-1"
                    type="button"
                    role="tab"
                    id={`tab-${language.id}`}
                    aria-controls={`panel-${language.id}`}
                    aria-selected={language === defaultLanguage ? 'true' : 'false'}
                    tabindex={language === defaultLanguage ? 0 : -1}
                    data-tab={language.id}
                  >
                    {language.name}
                  </button>
                ))}
              </div>
            </div>

            <div class="stage-grid">
              <div class="stage-queries">
                {languages.map((language) => (
                  <div
                    class:list={['stage-panel', { 'is-active': language === defaultLanguage }]}
                    id={`panel-${language.id}`}
                    role="tabpanel"
                    aria-labelledby={`tab-${language.id}`}
                  >
                    <span class="pane-label">
                      <span class="stage-name caption-5">{language.file}</span>
                      {language.status !== 'available' && (
                        <span class="stage-status caption-5">{statusLabel[language.status]}</span>
                      )}
                    </span>
                    {language.prose ? (
                      <div class="stage-ask">
                        <p class="title-1">{language.query}</p>
                        <div class="stage-route">
                          <span class="caption-5">Matched to a published query</span>
                          <ul class="route-list">
                            {publishedQueries.map((name) => (
                              <li class:list={['mono-data', { 'is-routed': name === routedQuery }]}>{name}</li>
                            ))}
                          </ul>
                          <dl class="route-params">
                            {routedParams.map((param) => (
                              <div>
                                <dt class="mono-data">{param.name}</dt>
                                <dd class="caption-5">{param.value}</dd>
                              </div>
                            ))}
                          </dl>
                        </div>
                      </div>
                    ) : (
                      <pre class="code mono-data"><code set:html={highlightGql(language.query)} /></pre>
                    )}
                  </div>
                ))}
              </div>
              <div class="stage-plan">
                <span class="pane-label caption-4">Plan</span>
                <ol class="plan">
                  {stage.steps.map((step) => (
                    <li class={`plan-step plan-${step.kind}`}>
                      <span class="plan-marker" aria-hidden="true"></span>
                      <span class="plan-body">
                        <span class="plan-name title-4">{step.name}</span>
                        <span class="plan-detail caption-5">{step.detail}</span>
                      </span>
                    </li>
                  ))}
                </ol>
              </div>
              <div class="stage-result">
                <span class="pane-label caption-4">Result</span>
                <ul class="result-rows">
                  {stage.rows.map((row) => (
                    <li class="result-row">
                      <span class="result-title title-4">{row.title}</span>
                      <span class="result-meta caption-5">{row.meta}</span>
                      <span class="result-value caption-1">{row.value}</span>
                    </li>
                  ))}
                </ul>
                <p class="result-note caption-5">{stage.note}</p>
              </div>
            </div>
            <p class="stage-caption body-6">
              One question, four ways to ask it. Each becomes the plan above, so the grants
              checked and the rows returned do not change with the language.{' '}
              {languageStatusSentence} Example rows.
            </p>
          </div>
        </section>
      </div>

      <section class="home-feature" id="capabilities" aria-labelledby="capabilities-title" data-reveal>
        <div class="feature-head">
          <h2 class="heading-3" id="capabilities-title">Graph, text and vector, planned together</h2>
          <p class="body-3">
            Graph traversal, full text and vector search are operators in the same plan,
            evaluated against the same caller, the same grants and the same instruction budget.
            No proxy, no post filter, no second round trip.
          </p>
          <a class="text-link" href={links.architecture} target="_blank" rel="noreferrer">
            Read the architecture
          </a>
        </div>

        <div class="bento">
          <article class="tile full">
            <div class="tile-head">
              <span class="tile-icon"><Icon name="graph" /></span>
              <div class="tile-text">
                <h3 class="title-3">Graph traversal</h3>
                <p class="body-6">Variable length patterns over the graph's adjacency, kept in stable memory.</p>
              </div>
              <a class="demo-link caption-1" href={links.lara} target="_blank" rel="noreferrer">Docs</a>
            </div>
            <div class="tile-figure">
              <svg
                class="fig-tree-svg"
                viewBox={`0 0 ${tree.width} ${tree.height}`}
                role="img"
                aria-label={`${traversal.source} cites ${traversal.branches.map((b) => b[0]).join(' and ')}, which cite ${traversal.branches.map((b) => b[1]).join(' and ')}. Nothing further is cited within ${traversal.bound} hops.`}
              >
                <defs>
                  <marker id="cites-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto">
                    <path d="M0 0 L8 4 L0 8 Z" class="tree-arrow" />
                  </marker>
                </defs>
                {tree.columns.map((column) => (
                  <text class="tree-col" x={column.x} y="24">{column.label}</text>
                ))}
                {tree.end && (
                  <g class="tree-end">
                    <rect x={tree.end.x} y={tree.end.y} width={tree.end.width} height={tree.end.height} rx="10" />
                    <text x={tree.end.x + tree.end.width / 2} y={tree.end.y + tree.end.height / 2 - 4}>No further citations</text>
                    <text x={tree.end.x + tree.end.width / 2} y={tree.end.y + tree.end.height / 2 + 14}>within the {traversal.bound} hop bound</text>
                  </g>
                )}
                {tree.edges.map((e) => (
                  <g>
                    <path class="tree-edge" d={e.d} marker-end="url(#cites-arrow)" />
                    <text class="tree-edge-label" x={e.lx} y={e.ly}>CITES</text>
                  </g>
                ))}
                {tree.nodes.map((node) => (
                  <g class:list={['tree-node', { 'is-source': node.hop === 0 }]}>
                    <circle cx={node.x} cy={node.y} r="8" />
                    <text x={node.x} y={node.y + 30}>{node.title}</text>
                  </g>
                ))}
              </svg>
              <ol class="fig-tree-list" aria-label={`Documents ${traversal.source} reaches through CITES`}>
                <li class="is-source"><span class="title-4">{traversal.source}</span></li>
                {traversal.branches.map((branch) =>
                  branch.map((title, hop) => (
                    <li style={`--hop: ${hop + 1}`}>
                      <span class="title-4">{title}</span>
                      <span class="caption-5">{hopLabel(hop + 1)}</span>
                    </li>
                  )),
                )}
                {traversalDepth < traversal.bound && (
                  <li class="is-end caption-5">No further citations within the {traversal.bound} hop bound</li>
                )}
              </ol>
            </div>
          </article>

          <article class="tile">
            <div class="tile-head">
              <span class="tile-icon"><Icon name="text" /></span>
              <div class="tile-text">
                <h3 class="title-3">Full text search</h3>
                <p class="body-6">Segment LSM postings with block max pruning and fixed point scores.</p>
              </div>
              <a class="demo-link caption-1" href={links.text} target="_blank" rel="noreferrer" aria-label="Full text search docs">Docs</a>
            </div>
            <div class="tile-figure">
              <div class="fig-html">
                <p class="fig-note caption-5">“sovereign cloud”, block max per posting block</p>
                <ul class="fig-blocks" style={`--threshold: ${textThreshold * 100}%`}>
                  {textBlocks.map((max) => (
                    <li class:list={['fig-block', { 'is-skipped': max < textThreshold }]}>
                      <span class="fig-block-track"><span class="fig-block-bar" style={`width: ${max * 100}%`}></span></span>
                      <span class="fig-block-value mono-data">{max.toFixed(2)}</span>
                      <span class="fig-block-state caption-5">{max < textThreshold ? 'skipped' : 'scored'}</span>
                    </li>
                  ))}
                </ul>
                <p class="fig-note caption-5">
                  Blocks that cannot beat the top k threshold of {textThreshold.toFixed(2)} are never decoded.
                </p>
              </div>
            </div>
          </article>

          <article class="tile">
            <div class="tile-head">
              <span class="tile-icon"><Icon name="vector" /></span>
              <div class="tile-text">
                <h3 class="title-3">Vector search</h3>
                <p class="body-6">Graph constrained candidates, quantized centroids and exact rerank.</p>
              </div>
              <a class="demo-link caption-1" href={links.vector} target="_blank" rel="noreferrer" aria-label="Vector search docs">Docs</a>
            </div>
            <div class="tile-figure">
              <div class="fig-html">
                <div class="fig-plane" aria-hidden="true">
                  <span class="fig-probe" style={`left: ${vectorQuery.x}%; top: ${(vectorQuery.y / 60) * 100}%; width: ${(1 + vectorEps) * bestCentroidDistance * 2}%;`}></span>
                  {centroids.map((c, i) => (
                    <span class:list={['fig-centroid', { 'is-probed': probed.has(i) }]} style={`left: ${c.x}%; top: ${(c.y / 60) * 100}%`}></span>
                  ))}
                  {vectorDots.map((dot) => (
                    <span class={`fig-dot is-${dot.state}`} style={`left: ${dot.x}%; top: ${(dot.y / 60) * 100}%`}>
                      {dot.rank > 0 && <span class="fig-rank mono-data">{dot.rank}</span>}
                    </span>
                  ))}
                  <span class="fig-query" style={`left: ${vectorQuery.x}%; top: ${(vectorQuery.y / 60) * 100}%`}></span>
                </div>
                <ul class="fig-legend caption-5">
                  <li><span class="fig-dot is-top" aria-hidden="true"></span>Top {vectorK}</li>
                  <li><span class="fig-dot is-candidate" aria-hidden="true"></span>Candidate</li>
                  <li><span class="fig-dot is-hidden" aria-hidden="true"></span>Not visible to the caller</li>
                  <li><span class="fig-dot is-unprobed" aria-hidden="true"></span>Partition not probed</li>
                </ul>
                <p class="fig-note caption-5">
                  {vectorStats.probed} of {vectorStats.partitions} partitions probed, {vectorStats.candidates} candidates,
                  {' '}{vectorStats.hidden} not visible to the caller, top {vectorK} reranked exactly.
                </p>
              </div>
            </div>
          </article>

          <article class="tile">
            <div class="tile-head">
              <span class="tile-icon"><Icon name="shield" /></span>
              <div class="tile-text">
                <h3 class="title-3">Authorization inside the plan</h3>
                <p class="body-6">Directional, property level grants are checked at plan time, before the first read.</p>
              </div>
              <a class="demo-link caption-1" href={links.security} target="_blank" rel="noreferrer" aria-label="Authorization docs">Docs</a>
            </div>
            <div class="tile-figure">
              <div class="fig-html">
                <table class="fig-reqs">
                  <thead>
                    <tr>
                      <th class="caption-5" scope="col">team-readable-documents needs</th>
                      <th class="caption-5" scope="col">Covered by</th>
                    </tr>
                  </thead>
                  <tbody>
                    {requirements.map((row) => (
                      <tr>
                        <td><Icon name="check" /><code class="mono-data">{row.need}</code></td>
                        <td><code class="mono-data">{row.grant}</code></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                <p class="fig-note caption-5">Three of its requirements. One uncovered requirement rejects the call before the first read.</p>
              </div>
            </div>
          </article>

          <article class="tile">
            <div class="tile-head">
              <span class="tile-icon"><Icon name="key" /></span>
              <div class="tile-text">
                <h3 class="title-3">Prepared queries</h3>
                <p class="body-6">Register once, publish with a grant, then call it from a browser without a backend.</p>
              </div>
              <a class="demo-link caption-1" href={links.security} target="_blank" rel="noreferrer" aria-label="Prepared query docs">Docs</a>
            </div>
            <div class="tile-figure">
              <div class="fig-html">
                <ol class="plan">
                  {preparedSteps.map((step) => (
                    <li class="plan-step">
                      <span class="plan-marker" aria-hidden="true"></span>
                      <span class="plan-body">
                        <span class="plan-name title-4">{step.name}</span>
                        <span class="plan-detail mono-data">{step.detail}</span>
                      </span>
                    </li>
                  ))}
                </ol>
              </div>
            </div>
          </article>

        </div>
      </section>

      <section class="home-feature home-split" id="permissions" aria-labelledby="permissions-title">
        <div class="feature-head">
          <h2 class="heading-3" id="permissions-title">Each caller sees only what they may read</h2>
          <p class="body-3">
            Grants are part of the plan, not a filter added afterwards. The same checks apply to
            your dapp’s own calls, to an anonymous visitor running a query you published, to
            search, and to anything you hand to a model, whether the question arrives as GQL or in
            natural language.
          </p>
          <a class="text-link" href={links.security} target="_blank" rel="noreferrer">
            Read the security model
          </a>
        </div>
        <ol class="plan permissions-rail">
          {permissionLayers.map((layer) => (
            <li class="plan-step">
              <span class="plan-marker" aria-hidden="true"></span>
              <span class="plan-body">
                <span class="plan-name title-2">{layer.name}</span>
                <span class="plan-detail body-6">{layer.text}</span>
              </span>
            </li>
          ))}
        </ol>
      </section>

      <section class="tagline">
        <p class="visually-hidden">{tagline}</p>
        <p class="tagline-text heading-2" aria-hidden="true" set:html={taglineMarkup} />
      </section>

      <section class="home-feature home-split" id="languages" aria-labelledby="languages-title">
        <div class="feature-head">
          <h2 class="heading-3" id="languages-title">Query in the language you know</h2>
          <p class="body-3">
            GQL (ISO/IEC 39075) is the interface today. The Gleaph dialect adds text and vector
            search, prepared queries and grants as ordinary syntax. Natural language is in beta and
            answers through the prepared queries you publish. {plannedSentence} are planned as
            further ways into the same plan, authorization and cost model.
          </p>
          <a class="text-link" href={links.gql} target="_blank" rel="noreferrer">
            Read the GQL reference
          </a>
        </div>

        <div class="code-card">
          <div class="code-bar">
            <span class="code-name caption-5">{dialectFile}</span>
            <span class="code-tag caption-4">Prepared query</span>
            <button
              class="cmd-copy code-copy"
              type="button"
              data-copy={dialectQuery}
              aria-label="Copy the query"
            >
              <span class="copy-idle"><Icon name="copy" /></span>
              <span class="copy-done"><Icon name="check" /></span>
            </button>
          </div>
          <pre class="code body-6"><code set:html={highlightGql(dialectQuery)} /></pre>
          <p class="code-note body-6">
            Registered once, published with a single <code>GRANT EXECUTE</code>, then called from a
            browser as an anonymous visitor. The plan still knows exactly which rows that caller
            may see.
          </p>
        </div>
      </section>

      <section class="home-feature" id="how-it-runs" aria-labelledby="how-it-runs-title">
        <div class="feature-head">
          <h2 class="heading-3" id="how-it-runs-title">How a query runs</h2>
          <p class="body-3">
            A request moves through three stages. Each stage keeps the caller and their grants
            attached, and the last one never sees an arbitrary query.
          </p>
          <a class="text-link" href={links.architecture} target="_blank" rel="noreferrer">
            Read the execution model
          </a>
        </div>

        <ol class="steps">
          {querySteps.map((step, index) => (
            <li class="step">
              <span class="step-num mono-data" aria-hidden="true">{index + 1}</span>
              <div class="step-body">
                <h3 class="title-2">{step.title}</h3>
                <p class="body-6">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>

        <figure class="architecture-figure">
          <svg viewBox="0 0 760 400" role="img" aria-label="A dapp calls the Router, which plans and dispatches work to graph shards and the graph index.">
            <rect class="arch-box" x="30" y="158" width="152" height="84" rx="12" />
            <text class="arch-title" x="52" y="190">dapp</text>
            <text class="arch-mono" x="52" y="212">prepared call</text>
            <text class="arch-mono" x="52" y="228">IC.PRINCIPAL</text>

            <path class="arch-arrow" d="M184 200 H244" />
            <text class="arch-mono" x="188" y="188">gql</text>

            <rect class="arch-box arch-box-accent" x="248" y="140" width="196" height="120" rx="12" />
            <text class="arch-title" x="270" y="172">Router</text>
            <text class="arch-mono" x="270" y="194">auth, plan, dispatch</text>
            <text class="arch-mono" x="270" y="210">budget and grants</text>
            <rect class="arch-chip" x="270" y="224" width="110" height="22" rx="6" />
            <text class="arch-chip-label" x="280" y="239">caller grants</text>

            <path class="arch-arrow" d="M446 170 C500 170 510 78 566 78" />
            <text class="arch-mono" x="486" y="182">plan blob</text>
            <path class="arch-arrow" d="M446 190 C510 190 520 190 566 190" />
            <path class="arch-arrow" d="M446 214 C500 214 510 306 566 306" />

            <rect class="arch-box" x="568" y="46" width="166" height="64" rx="12" />
            <text class="arch-title" x="586" y="72">Graph shard 0</text>
            <text class="arch-mono" x="586" y="92">graph executor</text>
            <rect class="arch-box" x="568" y="158" width="166" height="64" rx="12" />
            <text class="arch-title" x="586" y="184">Graph shard 1</text>
            <text class="arch-mono" x="586" y="204">graph executor</text>
            <rect class="arch-box" x="568" y="274" width="166" height="64" rx="12" />
            <text class="arch-title" x="586" y="300">graph-index</text>
            <text class="arch-mono" x="586" y="320">postings</text>

            <text class="arch-mono arch-mono-dim" x="30" y="376">graph shards execute planned work only, no ad hoc GQL</text>
            <g class="arch-step" aria-hidden="true">
              <circle cx="30" cy="158" r="12" /><text x="30" y="162">1</text>
              <circle cx="248" cy="140" r="12" /><text x="248" y="144">2</text>
              <circle cx="568" cy="46" r="12" /><text x="568" y="50">3</text>
              <circle cx="568" cy="158" r="12" /><text x="568" y="162">3</text>
            </g>
          </svg>
        </figure>
        <p class="arch-mobile body-6">
          A dapp calls the Router, which checks grants, plans the work and dispatches it to graph
          shards and the graph index.
        </p>
      </section>

      <section class="home-feature home-split" id="canister" aria-labelledby="canister-title">
        <div class="feature-head">
          <h2 class="heading-3" id="canister-title">Built for the canister, not bolted onto it</h2>
          <p class="body-3">
            Gleaph is not a server database compiled for Wasm. Storage layout, scoring and
            authorization were designed around stable memory and instruction budgets from the
            start.
          </p>
        </div>
        <ul class="facts">
          {facts.map((fact) => (
            <li>
              <h3 class="title-2">{fact.title}</h3>
              <p class="body-6">{fact.text}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="home-feature home-split" id="examples" aria-labelledby="examples-title">
        <div class="feature-head">
          <h2 class="heading-3" id="examples-title">What you can build</h2>
          <p class="body-3">
            Two working apps in the repository, each with its schema, seed data, prepared queries
            and generated client.
          </p>
        </div>
        <ul class="example-list">
          {examples.map((example) => (
            <li>
              <h3 class="title-2">{example.title}</h3>
              <p class="body-6">{example.text}</p>
              <p class="example-uses caption-5">{example.uses}</p>
              <a class="text-link caption-1" href={example.href} target="_blank" rel="noreferrer">
                Open the source
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="home-feature" id="docs" aria-labelledby="docs-title">
        <div class="feature-head">
          <h2 class="heading-3" id="docs-title">Start where you like</h2>
          <p class="body-3">
            Run the quickstart end to end, read the dialect reference, or take the security and
            storage models apart. The repository is the documentation.
          </p>
          <a class="text-link" href={links.readme} target="_blank" rel="noreferrer">
            Read the README
          </a>
        </div>
        <ul class="guide-list">
          {guides.map((guide) => (
            <li>
              <a class="guide-link" href={guide.href} target="_blank" rel="noreferrer">
                <span class="guide-title title-2">{guide.title}</span>
                <span class="guide-text body-6">{guide.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="home-feature home-split" id="faq" aria-labelledby="faq-title">
        <div class="feature-head">
          <h2 class="heading-3" id="faq-title">Questions</h2>
          <p class="body-3">
            Short answers about the runtime, the data boundary and the licence. The design
            documents go further.
          </p>
          <a class="text-link" href={links.design} target="_blank" rel="noreferrer">
            Read the design documents
          </a>
        </div>
        <div class="faq-list">
          {faq.map((item) => (
            <details class="faq-item">
              <summary>
                <span class="faq-q title-2">{item.q}</span>
                <span class="faq-toggle" aria-hidden="true"></span>
              </summary>
              <div class="faq-a body-3">
                {item.a}
                {item.url && (
                  <>
                    {' '}
                    <a class="inline-link" href={item.url} target="_blank" rel="noreferrer">
                      {item.linkLabel ?? 'Learn more'}
                    </a>
                  </>
                )}
              </div>
            </details>
          ))}
        </div>
      </section>

      <section class="home-cta" id="quickstart" aria-labelledby="quickstart-title">
        <div class="home-cta-art" aria-hidden="true" data-dither="cta"></div>
        <div class="home-cta-body">
          <h2 class="heading-3" id="quickstart-title">Start with one query</h2>
          <p class="body-3">
            Bring up a local network and run a prepared query against a real knowledge graph. The
            quickstart covers migration, load, grants and the generated client.
          </p>
          <div class="hero-actions">
            <a class="btn primary button-md" href={links.quickstart} target="_blank" rel="noreferrer">
              Run the quickstart
            </a>
            <a class="text-link caption-1" href={links.repo} target="_blank" rel="noreferrer">
              Source on GitHub
            </a>
          </div>
        </div>
      </section>
      <p class="risk-note caption-5">
        Open source, Apache 2.0 or MIT. Self deployable, no per query fees.
      </p>

      <p class="art-credit caption-5">
        Photograph:&#32;
        <a
          href="https://commons.wikimedia.org/wiki/File:Sunset_on_Dunes_and_Crestone_Peaks_(26008762262).jpg"
          target="_blank"
          rel="noreferrer">NPS / Patrick Myers</a
        >, “Sunset on Dunes and Crestone Peaks”, Great Sand Dunes National Park. Public domain,
        rendered as an ordered halftone.
      </p>
    </main>

    <footer class="site-footer">
      <div class="footer-brand">
        <span class="brand-mark footer-mark" aria-hidden="true"></span>
        <span class="caption-2">© {year} Gleaph. Apache 2.0 or MIT.</span>
      </div>
      <nav aria-label="Footer">
        <a class="caption-2" href={links.readme} target="_blank" rel="noreferrer">README</a>
        <a class="caption-2" href={links.design} target="_blank" rel="noreferrer">Design</a>
        <a class="caption-2" href={links.quickstart} target="_blank" rel="noreferrer">Demo</a>
        <a class="caption-2" href={links.apache} target="_blank" rel="noreferrer">License</a>
        <a class="caption-2" href={links.repo} target="_blank" rel="noreferrer">GitHub</a>
      </nav>
      <p class="footer-note caption-5">
        Gleaph is in active development. AI inference under the same optimizer is a design
        direction under exploration, not a shipped feature.
      </p>
    </footer>
  </div>

  <script type="application/ld+json" set:html={faqJsonLd} />

  <script>
    import { mountDither } from '../lib/dither';

    const root = document.documentElement;
    const reduceMotion = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ------------------------------------------------------------------ theme
    const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

    function applyTheme(theme: 'light' | 'dark') {
      root.dataset.theme = theme;
      root.classList.toggle('dark', theme === 'dark');
      themeButton?.setAttribute(
        'aria-label',
        theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme',
      );
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', theme === 'dark' ? '#161616' : '#f5f3ef');
      try {
        localStorage.setItem('gleaph-theme', theme);
      } catch {
        // private mode: the toggle still works for this session
      }
    }

    applyTheme(root.dataset.theme === 'dark' ? 'dark' : 'light');
    themeButton?.addEventListener('click', () =>
      applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark'),
    );

    // -------------------------------------------------------------- mobile menu
    const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menu = document.getElementById('site-menu');
    const menuBackground = [document.querySelector('main'), document.querySelector('footer')];

    function setMenu(open: boolean) {
      if (!menuButton || !menu) return;
      menuButton.setAttribute('aria-expanded', String(open));
      menuButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.body.classList.toggle('menu-open', open);
      for (const element of menuBackground) {
        if (!element) continue;
        if (open) element.setAttribute('inert', '');
        else element.removeAttribute('inert');
      }
      if (open) {
        menu.hidden = false;
        requestAnimationFrame(() => menu.classList.add('is-open'));
        menu.querySelector<HTMLAnchorElement>('a')?.focus();
      } else {
        menu.classList.remove('is-open');
        menu.hidden = true;
        menuButton.focus();
      }
    }

    menuButton?.addEventListener('click', () => {
      const open = menuButton.getAttribute('aria-expanded') !== 'true';
      setMenu(open);
    });
    menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
    menu?.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab') return;
      const links = Array.from(menu.querySelectorAll<HTMLAnchorElement>('a'));
      const first = links[0];
      const last = links[links.length - 1];
      if (!first || !last) return;
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
    addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') setMenu(false);
    });
    matchMedia('(min-width: 761px)').addEventListener('change', (event) => {
      if (event.matches && menuButton?.getAttribute('aria-expanded') === 'true') setMenu(false);
    });

    // ------------------------------------------------------------- the artwork
    const heroArt = document.querySelector<HTMLElement>('[data-dither="hero"]');
    if (heroArt) mountDither(heroArt, { loop: true, reveal: true });

    const ctaArt = document.querySelector<HTMLElement>('[data-dither="cta"]');
    if (ctaArt) {
      mountDither(ctaArt, { loop: true, reveal: 'view', focusY: 0.16, gamma: 1.12 });
    }

    // ------------------------------------------------------- scroll and header
    // The halftone drifts down at a fraction of the page speed, so it reads as
    // a slower layer behind the copy. It is a single transform, updated once
    // per scroll frame, and it stops at one viewport of scroll.
    const heroArtLayer = document.querySelector<HTMLElement>('.home-art .dither');

    function applyParallax() {
      if (!heroArtLayer) return;
      if (reduceMotion()) {
        heroArtLayer.style.transform = '';
        return;
      }
      const factor = innerWidth <= 760 ? 0.15 : 0.26;
      const offset = Math.min(scrollY, innerHeight) * factor;
      heroArtLayer.style.transform = `translate3d(0, ${offset.toFixed(1)}px, 0)`;
    }

    let scrollFrame = 0;
    function onScroll() {
      if (scrollFrame) return;
      scrollFrame = requestAnimationFrame(() => {
        scrollFrame = 0;
        document.body.classList.toggle('scrolled', scrollY > 4);
        applyParallax();
      });
    }
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', applyParallax);
    matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', applyParallax);
    applyParallax();

    // ---------------------------------------------- section reveals, once each
    if (!reduceMotion()) {
      const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
      for (const section of sections) section.classList.add('section-reveal');
      const revealObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('in');
            revealObserver.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -6% 0px', threshold: 0 },
      );
      for (const section of sections) revealObserver.observe(section);
    }

    // ------------------------------------------ tagline, one word at a time
    // Each word turns on as it crosses a line at 62% of the viewport, in
    // reading order. One rAF per scroll burst keeps this cheap.
    const taglineWords = Array.from(document.querySelectorAll<HTMLElement>('.tagline-word'));
    if (taglineWords.length) {
      if (reduceMotion()) {
        for (const word of taglineWords) word.classList.add('is-on');
      } else {
        let taglineFrame = 0;
        const lightTaglineWords = () => {
          taglineFrame = 0;
          const line = innerHeight * 0.62;
          for (const word of taglineWords) {
            if (word.classList.contains('is-on')) continue;
            if (word.getBoundingClientRect().top < line) word.classList.add('is-on');
          }
        };
        const queueTagline = () => {
          if (taglineFrame) return;
          taglineFrame = requestAnimationFrame(lightTaglineWords);
        };
        addEventListener('scroll', queueTagline, { passive: true });
        addEventListener('resize', queueTagline);
        lightTaglineWords();
      }
    }

    // -------------------------------------------------------------- stage tabs
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.show-tab'));
    const tablist = document.querySelector<HTMLElement>('.show-tabs');
    const indicator = document.querySelector<HTMLElement>('.slide-ind');
    const stages = Array.from(document.querySelectorAll<HTMLElement>('.stage-panel'));

    function placeIndicator(button: HTMLButtonElement | undefined, instant = false) {
      if (!indicator || !button) return;
      if (instant) indicator.classList.add('no-anim');
      indicator.style.width = `${button.offsetWidth}px`;
      indicator.style.transform = `translateX(${button.offsetLeft}px)`;
      indicator.classList.add('on');
      if (instant) {
        requestAnimationFrame(() =>
          requestAnimationFrame(() => indicator.classList.remove('no-anim')),
        );
      }
    }

    function selectTab(id: string | undefined) {
      if (!id) return;
      for (const tab of tabs) {
        const selected = tab.dataset.tab === id;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
      }
      for (const stage of stages) {
        stage.classList.toggle('is-active', stage.id === `panel-${id}`);
      }
      placeIndicator(tabs.find((tab) => tab.dataset.tab === id));
    }

    for (const tab of tabs) {
      tab.addEventListener('click', () => selectTab(tab.dataset.tab));
    }

    tablist?.addEventListener('keydown', (event) => {
      const current = tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
      let next = current;
      if (event.key === 'ArrowRight') next = (current + 1) % tabs.length;
      else if (event.key === 'ArrowLeft') next = (current - 1 + tabs.length) % tabs.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = tabs.length - 1;
      else return;
      event.preventDefault();
      const button = tabs[next];
      selectTab(button.dataset.tab);
      button.focus();
    });

    if (tabs.length) {
      selectTab(tabs.find((tab) => tab.getAttribute('aria-selected') === 'true')?.dataset.tab);
      const tabsResize = new ResizeObserver(() => {
        placeIndicator(
          tabs.find((tab) => tab.getAttribute('aria-selected') === 'true'),
          true,
        );
      });
      if (tablist) tabsResize.observe(tablist);
    }

    // ------------------------------------------------------------- copy buttons
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
      button.addEventListener('click', async () => {
        const text = button.dataset.copy ?? '';
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const field = document.createElement('textarea');
          field.value = text;
          field.style.position = 'fixed';
          field.style.opacity = '0';
          document.body.append(field);
          field.select();
          document.execCommand('copy');
          field.remove();
        }
        const label = button.getAttribute('aria-label') ?? 'Copy';
        button.classList.add('copied');
        button.setAttribute('aria-label', 'Copied');
        window.setTimeout(() => {
          button.classList.remove('copied');
          button.setAttribute('aria-label', label);
        }, 1500);
      });
    }
  </script>
</Layout>
