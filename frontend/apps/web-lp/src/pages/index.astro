  quickstart: `${REPO}/tree/main/demo/knowledge`,
  design: `${REPO}/tree/main/design`,
  architecture: `${REPO}/blob/main/design/architecture/overview.md`,
  gql: `${REPO}/blob/main/design/gql/extension-syntax.md`,
  security: `${REPO}/blob/main/design/security/rbac-and-prepared.md`,
  lara: `${REPO}/blob/main/design/storage/lara.md`,
  text: `${REPO}/blob/main/design/index/text-index.md`,
  vector: `${REPO}/blob/main/design/index/vector-index.md`,
  sdk: `${REPO}/tree/main/sdk`,
  cli: `${REPO}#command-line-interface`,
  apache: `${REPO}/blob/main/LICENSE-APACHE`,
  mit: `${REPO}/blob/main/LICENSE-MIT`,
};

const year = new Date().getFullYear();

// --- Query highlighting -----------------------------------------------------
// A deliberately small tokenizer: the landing page shows one question in GQL,
// Cypher and SQL/PGQ plus one dialect query, and they only need keywords,
// strings, variables, calls and comments.
const KEYWORDS = new Set(
  (
    'MATCH WHERE RETURN ORDER BY LIMIT OFFSET SEARCH IN FOR SCORE AS DESC ASC AND OR ' +
    'DISTINCT OPTIONAL CREATE TEXT VECTOR INDEX ON GRANT EXECUTE PREPARED QUERY TO ' +
    'PUBLIC ANALYZER ANY SHORTEST TRUE FALSE NULL USE GRAPH SELECT FROM IS COLUMNS'
  ).split(' '),
);
const CALLS = new Set(['text_score', 'ELEMENT_ID', 'INSERTION', 'COUNT', 'SHORTEST', 'elementId', 'LISTAGG', 'GRAPH_TABLE']);

const escapeHtml = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

function highlightGql(source: string): string {
  let out = '';
  for (let i = 0; i < source.length; ) {
    const rest = source.slice(i);
    let match: RegExpMatchArray | null;

    if ((match = rest.match(/^\/\/[^\n]*/))) {
      out += `<span class="tok-com">${escapeHtml(match[0])}</span>`;
    } else if ((match = rest.match(/^'(?:[^'\\]|\\.)*'/))) {
      out += `<span class="tok-str">${escapeHtml(match[0])}</span>`;
    } else if ((match = rest.match(/^\$[A-Za-z_]\w*/))) {
      out += `<span class="tok-var">${escapeHtml(match[0])}</span>`;
    } else if ((match = rest.match(/^\d+(?:\.\d+)?/))) {
      out += `<span class="tok-num">${escapeHtml(match[0])}</span>`;
    } else if ((match = rest.match(/^[A-Za-z_]\w*/))) {
      const word = match[0];
      const cls = KEYWORDS.has(word.toUpperCase())
        ? 'tok-kw'
        : CALLS.has(word)
          ? 'tok-call'
          : '';
      out += cls ? `<span class="${cls}">${escapeHtml(word)}</span>` : escapeHtml(word);
    } else {
      const char = rest[0];
      out += char === '\n' ? '\n' : escapeHtml(char);
      i += 1;
      continue;
    }
    i += match[0].length;
  }
  return out;
}

// --- The stage: one question, four ways to ask it, one plan ---------------------
// `languages` is the single list of ways in. GQL ships, natural language is the
// beta router, Cypher and SQL/PGQ are planned; the hero list, the stage tabs,
// the GQL section and the FAQ all read their status from here.
// The question is one a reader of a team knowledge base would ask, answered by
// a query the knowledge demo publishes: demo/knowledge/prepared/
// team-readable-documents.gql (granted in demo/knowledge/grants/knowledge.gql).
// The GQL text is that file; keep them in sync. The Cypher and SQL/PGQ texts
// are the same query in each language's syntax with the same SEARCH extension
// GQL uses, drafts of planned front ends that nothing executes yet.
type Status = 'available' | 'beta' | 'planned';
const statusLabel: Record<Status, string> = { available: 'Available', beta: 'Beta', planned: 'Planned' };

type Language = {
  id: 'nl' | 'gql' | 'cypher' | 'pgq';
  name: string;
  status: Status;
  file: string;
  query: string;
  prose?: boolean;
};

// The prepared queries published by demo/knowledge (demo/knowledge/prepared),
// the query the beta router picks for the question, and the parameter it fills.
const publishedQueries = [
  'citation-reach',
  'document-text-search',
  'shortest-path',
  'team-readable-documents',
  'variable-length-reach',
];
const routedQuery = 'team-readable-documents';
const routedParams = [{ name: 'query', value: '“access control”, sent as an embedding' }];

const languages: Language[] = [
  {
    id: 'nl',
    name: 'Natural language',
    status: 'beta',
    file: 'question',
    prose: true,
    query: 'What has the Platform team written about access control?',
  },
  {
    id: 'gql',
    name: 'GQL',
    status: 'available',
    file: 'team-readable-documents.gql',
    query: `MATCH (t:Team {name: 'Platform'})<-[:BELONGS_TO]-(p:Person)-[:OWNS]->(d:Document)
WHERE d.is_public = TRUE
SEARCH d IN (
  VECTOR INDEX document_embedding
  FOR $query
  LIMIT 5
) SCORE AS similarity
RETURN ELEMENT_ID(d) AS document_id, d.title AS title, similarity
ORDER BY similarity DESC`,
  },
  {
    id: 'cypher',
    name: 'Cypher',
    status: 'planned',
    file: 'team-readable-documents.cypher',
    query: `MATCH (t:Team {name: 'Platform'})<-[:BELONGS_TO]-(p:Person)-[:OWNS]->(d:Document)
WHERE d.is_public = true
SEARCH d IN (
  VECTOR INDEX document_embedding
  FOR $query
  LIMIT 5
) SCORE AS similarity
RETURN elementId(d) AS document_id, d.title AS title, similarity
ORDER BY similarity DESC`,
  },
  {
    id: 'pgq',
    name: 'SQL/PGQ',
    status: 'planned',
    file: 'team-readable-documents.sql',
    query: `SELECT document_id, title, similarity
FROM GRAPH_TABLE (knowledge
  MATCH (t IS Team WHERE t.name = 'Platform')<-[IS BELONGS_TO]-(p IS Person)
        -[IS OWNS]->(d IS Document WHERE d.is_public = TRUE)
  SEARCH d IN (VECTOR INDEX document_embedding FOR $query LIMIT 5) SCORE AS similarity
  COLUMNS (ELEMENT_ID(d) AS document_id, d.title AS title, similarity)
)
ORDER BY similarity DESC`,
  },
];
// The stage opens on the plain question: anyone can read it, it matches the
// order of the hero copy and the tabs, and its panel shows the route from the
// question to a published query. Its Beta label stays visible.
const defaultLanguageId: Language['id'] = 'nl';
const defaultLanguage = languages.find((language) => language.id === defaultLanguageId)!;
const namesWith = (status: Status) =>
  languages.filter((language) => language.status === status).map((language) => language.name);
const listSentence = (names: string[]) =>
  names.length > 1 ? `${names.slice(0, -1).join(', ')} and ${names.at(-1)}` : names[0];
const availableSentence = listSentence(namesWith('available'));
const betaSentence = listSentence(namesWith('beta'));
const plannedSentence = listSentence(namesWith('planned'));
const languageStatusSentence = `${availableSentence} runs today, ${betaSentence.toLowerCase()} is in beta, and ${plannedSentence} are planned.`;
const routingSentence =
  'A question in natural language is matched, by a model that runs on chain, to one of the prepared queries the graph has published, and that query’s typed parameters are filled in. The beta never writes a query from free text.';

// The plan and the rows are rendered once: switching language changes the
// query text and nothing else. The row is what the demo's seed data returns:
// the Platform team's members own one public document.
type Step = { kind: 'auth' | 'graph' | 'vector' | 'project'; name: string; detail: string };
type Row = { title: string; meta: string; value: string };

const stage: { steps: Step[]; rows: Row[]; note: string } = {
  steps: [
    { kind: 'auth', name: 'Authorize', detail: 'grants checked before the first read' },
    { kind: 'graph', name: 'Match team documents', detail: 'Team to Person to Document, public only' },
    { kind: 'vector', name: 'Vector search', detail: 'top 5 by similarity to the question' },
    { kind: 'project', name: 'Project', detail: 'titles and similarity' },
  ],
  rows: [{ title: 'Access control in graph queries', meta: 'Owned by Carol, Platform team, public', value: 'top match' }],
  note: '1 document: the only public document the Platform team owns in the demo data',
};

// --- The dialect query in the GQL section ---------------------------------------
// Copied from demo/knowledge/prepared/document-text-search.gql: full text search,
// the retrieval the stage no longer shows.
const dialectFile = 'document-text-search.gql';
const dialectQuery = `MATCH (d:Document)
RETURN ELEMENT_ID(d) AS document_id, d.title AS title, text_score(d.body, $query) AS score
ORDER BY text_score(d.body, $query) DESC LIMIT 5`;

// --- Capability figures -------------------------------------------------------
// Block max pruning: a posting block is decoded only when its best possible
// score can still beat the current top k threshold. Example values.
const textThreshold = 0.6;
const textBlocks = [0.82, 0.41, 0.76, 0.28, 0.71];

// Graph traversal: citation-reach over the demo's seed data
// (demo/knowledge/seeds/edges.jsonl). From "GraphRAG retrieval", CITES reaches
// two documents at one hop and one more behind each at two hops; nothing is
// cited past that, so the {1,3} bound is never reached.
const traversal = {
  source: 'GraphRAG retrieval',
  bound: 3,
  branches: [
    ['The GQL standard', 'Introduction to graph databases'],
    ['Vector search in graphs', 'Indexing for traversal'],
  ],
};
const traversalDepth = Math.max(...traversal.branches.map((branch) => branch.length));
const hopLabel = (hops: number) => `${hops} ${hops === 1 ? 'hop' : 'hops'}`;

// The drawing: one column per hop (start plus the bound), one row per branch,
// in a 1200-unit wide viewBox that renders close to 1:1 in the full width tile.
// Every node position, edge curve and label is computed here from `traversal`,
// so the lines always meet the dots they join.
const tree = (() => {
  // Columns sit 110 units in from each edge, room for a centred title or the
  // end box to stay inside the 1200-unit drawing.
  const width = 1200;
  const inset = 110;
  const colX = (col: number) => inset + (col * (width - 2 * inset)) / traversal.bound;
  const rowY = (row: number) => 92 + row * 96;
  const lastRowY = rowY(traversal.branches.length - 1);
  const source = { x: colX(0), y: (rowY(0) + lastRowY) / 2, title: traversal.source, hop: 0 };
  const nodes = [source];
  const edges: Array<{ d: string; lx: number; ly: number }> = [];
  const r = 8;
  const edge = (a: { x: number; y: number }, b: { x: number; y: number }) => {
    const mid = (a.x + b.x) / 2;
    edges.push({
      d: `M ${a.x + r} ${a.y} C ${mid} ${a.y}, ${mid} ${b.y}, ${b.x - r - 4} ${b.y}`,
      lx: mid,
      ly: (a.y + b.y) / 2 - 10,
    });
  };
  traversal.branches.forEach((branch, row) => {
    let previous = source;
    branch.forEach((title, i) => {
      const node = { x: colX(i + 1), y: rowY(row), title, hop: i + 1 };
      nodes.push(node);
      edge(previous, node);
      previous = node;
    });
  });
  const end =
    traversalDepth < traversal.bound
      ? {
          x: colX(traversalDepth + 1) - inset + 8,
          y: rowY(0) - 32,
          width: colX(traversal.bound) - colX(traversalDepth + 1) + 2 * (inset - 8),
          height: lastRowY - rowY(0) + 64,
        }
      : null;
  return {
    width,
    height: lastRowY + 56,
    columns: Array.from({ length: traversal.bound + 1 }, (_, i) => ({ x: colX(i), label: i === 0 ? 'Start' : hopLabel(i) })),
    nodes,
    edges,
    end,
  };
})();

// Vector search: the partition rule and per-candidate visibility, computed
// from example points so the drawing follows the rule instead of being
// placed by hand. Coordinates live in a 100 x 60 plane.
const vectorQuery = { x: 40, y: 32 };
const vectorEps = 0.45; // probe partitions within (1 + eps) of the nearest centroid
const vectorK = 3;
const centroids = [
  { x: 22, y: 18 },
  { x: 52, y: 22 },
  { x: 78, y: 16 },
  { x: 30, y: 46 },
  { x: 68, y: 46 },
];
const vectorPoints: Array<{ x: number; y: number; visible?: false }> = [
  { x: 14, y: 12 }, { x: 26, y: 10 }, { x: 18, y: 26 }, { x: 30, y: 22 },
  { x: 46, y: 16 }, { x: 58, y: 14 }, { x: 44, y: 26, visible: false }, { x: 57, y: 28 }, { x: 51, y: 33 },
  { x: 74, y: 8 }, { x: 86, y: 12 }, { x: 80, y: 24 },
  { x: 22, y: 50 }, { x: 34, y: 54 }, { x: 37, y: 40 }, { x: 26, y: 40 },
  { x: 60, y: 40 }, { x: 64, y: 52 }, { x: 76, y: 50 }, { x: 72, y: 40 },
];
const distance = (a: { x: number; y: number }, b: { x: number; y: number }) =>
  Math.hypot(a.x - b.x, a.y - b.y);
const nearestCentroid = (point: { x: number; y: number }) =>
  centroids.reduce((best, c, i) => (distance(point, c) < distance(point, centroids[best]) ? i : best), 0);
const bestCentroidDistance = Math.min(...centroids.map((c) => distance(vectorQuery, c)));
const probed = new Set(
  centroids.flatMap((c, i) => (distance(vectorQuery, c) <= (1 + vectorEps) * bestCentroidDistance ? [i] : [])),
);
const ranked = vectorPoints
  .map((point) => ({ ...point, candidate: probed.has(nearestCentroid(point)), d: distance(vectorQuery, point) }))
  .filter((point) => point.candidate && point.visible !== false)
  .sort((a, b) => a.d - b.d)
  .slice(0, vectorK);
const vectorDots = vectorPoints.map((point) => {
  const candidate = probed.has(nearestCentroid(point));
  const rank = ranked.findIndex((r) => r.x === point.x && r.y === point.y);
  const state = rank >= 0 ? 'top' : !candidate ? 'unprobed' : point.visible === false ? 'hidden' : 'candidate';
  return { ...point, state, rank: rank + 1 };
});
const vectorStats = {
  probed: probed.size,
  partitions: centroids.length,
  candidates: vectorDots.filter((d) => d.state !== 'unprobed').length,
  hidden: vectorDots.filter((d) => d.state === 'hidden').length,
};

// Authorization: three of the requirements of the stage's query, each beside
// the published grant that covers it (demo/knowledge/grants/knowledge.gql).
const requirements = [
  { need: 'MATCH Team', grant: 'GRANT MATCH … NODES Team' },
  { need: 'TRAVERSE OWNS', grant: 'GRANT TRAVERSE … EDGES OWNS' },
  { need: 'READ Document.is_public', grant: 'GRANT READ … Document { …, is_public }' },
];

// Prepared queries: the three commands that take the stage's query from a file
// to a browser call (demo/knowledge README, grants and generated client).
const preparedSteps = [
  { name: 'Register', detail: 'gleaph prepared apply' },
  { name: 'Publish', detail: 'GRANT EXECUTE ON PREPARED QUERY "team-readable-documents" TO PUBLIC' },
  { name: 'Call from the browser', detail: 'await client.teamReadableDocuments({ query })' },
];

// --- How a query runs -------------------------------------------------------
const querySteps = [
  {
    title: 'One statement',
    text: 'A prepared or ad hoc GQL statement is parsed and validated. Text and vector search are part of the same statement, not a second round trip.',
  },
  {
    title: 'The Router plans and authorizes',
    text: 'The Router binds the caller grants into the plan, encodes it as a plan blob and dispatches it with a seed where an index anchor exists.',
  },
  {
    title: 'Graph shards execute',
    text: 'Shards accept planned work and return rows. They never expose arbitrary GQL to callers, so there is no path around the plan.',
  },
];

// --- Tagline ----------------------------------------------------------------
const tagline =
  'One plan answers the graph, the text and the vector, in canisters dedicated to your graph.';
const taglineWords = tagline.split(' ');
const taglineMarkup = taglineWords
  .map((word) => `<span class="tagline-word">${escapeHtml(word)}</span>`)
  .join('&#32;');

// --- Facts ------------------------------------------------------------------
const facts = [
  {
    title: 'Graph in stable memory',
    text: 'The graph engine keeps adjacency in stable memory, so the graph survives upgrades without a server runtime behind it.',
  },
  {
    title: 'Scoring within budget',
    text: 'Text and vector scores use fixed point arithmetic sized for canister instruction budgets, not floating point afterthoughts.',
  },
  {
    title: 'Your graph, its own canisters',
    text: 'Each graph runs in canisters of its own on the chain, with no rented server and no per query fees. An operator holds the controller role today; handing it to the graph owner is on the roadmap.',
  },
  {
    title: 'ISO standard language',
    text: 'GQL (ISO/IEC 39075) with a documented Internet Computer dialect. One language for reads, writes and search.',
  },
];

// --- Permissions: the three places a caller's grants apply ----------------------
// From design/security/rbac-and-prepared.md: query admission, per-candidate
// visibility and context assembly.
const permissionLayers = [
  {
    name: 'Admit the query',
    text: 'Before the first read, everything the query needs is checked against the caller’s grants. A missing grant rejects the whole query, so no row is read and no embedding is compared.',
  },
  {
    name: 'Filter every candidate',
    text: 'Search candidates pass the same visibility rules as any other row, so the vector top k is the top k of what the caller may see.',
  },
  {
    name: 'Build the context from results',
    text: 'What reaches a model comes from query results only, so it never holds a row the caller could not read.',
  },
];

// --- What you can build -------------------------------------------------------
// Both are working apps in the repository; the text says what each one stores
// and which parts of the engine it uses.
const examples = [
  {
    title: 'A team knowledge base',
    text: 'Documents, people, teams and concepts, linked by citations and ownership. Readers search by words or by meaning and follow citations, and each one sees only the documents their grants cover.',
    uses: 'Graph traversal, full text and vector search, prepared queries, grants',
    href: links.quickstart,
  },
  {
    title: 'A social feed with semantic search',
    text: 'Users, posts and follows. A public timeline and home feeds, a topic path across replies, and search over post embeddings.',
    uses: 'Graph traversal, vector search, prepared queries',
    href: `${REPO}/tree/main/demo/social`,
  },
];

// --- Guides -----------------------------------------------------------------
const guides = [
  {
    title: 'Quickstart',
    text: 'Bring up a local network, load the knowledge graph and run prepared queries end to end.',
    href: links.quickstart,
  },
  {
    title: 'GQL reference',
    text: 'The dialect: text and vector search, IC values, procedures and prepared queries.',
    href: links.gql,
  },
  {
    title: 'Prepared queries',
    text: 'Register once, publish with a grant, then call it from a browser with no backend of its own.',
    href: links.security,
  },
  {
    title: 'Client SDKs',
    text: 'TypeScript, Rust and canister clients with generated typed bindings for prepared queries.',
    href: links.sdk,
  },
  {
    title: 'Storage model',
    text: 'How adjacency, relocation and tree CSR live inside stable memory on a canister.',
    href: links.lara,
  },
  {
    title: 'CLI and codegen',
    text: 'One CLI for networks, migrations, grants and typed clients for your frontend.',
    href: links.cli,
  },
];

// --- FAQ --------------------------------------------------------------------
type FaqItem = { q: string; a: string; url?: string; linkLabel?: string };

const faq: FaqItem[] = [
  {
    q: 'What is Gleaph?',
    a: 'A graph database engine for the Internet Computer. One GQL query plan answers graph traversal, full text search and vector retrieval, with the caller grants enforced inside the plan.',
  },
  {
    q: 'What is the Internet Computer?',
    a: 'A public blockchain network where applications run as canisters. A canister is a smart contract that holds both code and data, so the database engine and your graph live on the chain instead of on a server you rent. Gleaph is built for it and runs there as canisters.',
    url: 'https://internetcomputer.org/',
    linkLabel: 'internetcomputer.org',
  },
  {
    q: 'Does it run outside the Internet Computer?',
    a: 'No. The engine is built for Wasm canisters: graph storage, instruction budgeted scoring and authorization are designed around the IC runtime.',
  },
  {
    q: 'Where does my data live?',
    a: 'In canisters dedicated to your graph. Every graph has its own canisters, running costs are the cycles you fund, and the engine adds no per query fees. Canister controllership is operator managed today, with self service provisioning and graph owner control on the roadmap.',
  },
  {
    q: 'Which query languages does it support?',
    a: `GQL (ISO/IEC 39075) today, with the Gleaph dialect for text and vector search. Natural language is in beta. ${routingSentence} ${plannedSentence} are planned and not shipped yet.`,
  },
  {
    q: 'What does authorization aware mean?',
    a: 'Data plane grants are part of the plan. Directional, property level privileges and conditional policies are checked at plan time, so a row the caller cannot read never becomes a candidate.',
  },
  {
    q: 'What search does it support?',
    a: 'Graph patterns, full text search over a segment LSM index with fixed point scoring and block max pruning, and vector search over graph constrained candidates with exact rerank.',
  },
  {
    q: 'How do I call it from a browser?',
    a: 'Register a prepared query, publish it with GRANT EXECUTE ON PREPARED QUERY, then call it through the TypeScript SDK. You do not need a backend canister of your own.',
  },
  {
    q: 'What is the license?',
    a: 'Apache 2.0 or MIT, at your option. The repository is self deployable, and your data stays readable through authorized GQL at all times.',
  },
  {
    q: 'Is AI inference available today?',
    a: `Natural language routing is in beta: ${routingSentence.charAt(0).toLowerCase()}${routingSentence.slice(1)} Generating answers with a language model inside the optimizer is a design direction under exploration, not a shipped feature.`,
  },
];

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
});
