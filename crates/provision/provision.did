// Candid interface for the Provision canister.
// Keep this file byte-for-byte in sync with the exported service; the candid test enforces it.

type AdmissionQuote = record {
  fee : nat;
  total : nat;
  resource_count : nat32;
  cost : nat;
  reserve : nat;
  service_config_version : nat32;
};
type AdmissionQuoteError = variant { ArithmeticOverflow };
type ArtifactAuditAction = variant {
  PublishArtifact;
  ActivateRelease;
  PublishRelease;
  UploadChunk;
  VerifyArtifact;
  InstallRelease;
};
type ArtifactAuditEntry = record {
  action : ArtifactAuditAction;
  timestamp_ns : nat64;
  artifact_id : opt ArtifactId;
  release_id : opt text;
  target_canister : opt principal;
  caller : principal;
  outcome : ArtifactAuditOutcome;
  deployment_id : opt text;
  reason : opt text;
};
type ArtifactAuditOutcome = variant { Failed; Rejected; Success };
type ArtifactError = variant {
  TooManyChunks : record { max : nat32; declared : nat32 };
  NotProvision : CanisterKind;
  UnknownArtifact : ArtifactId;
  Unauthorized;
  ChunkHashMismatch : record { chunk_index : nat32; artifact_id : ArtifactId };
  ChunkOutOfRange : record {
    chunk_index : nat32;
    artifact_id : ArtifactId;
    declared : nat32;
  };
  ConflictingMetadata : record {
    requested : ArtifactId;
    existing : ArtifactId;
  };
  FullSha256Mismatch : record { actual : blob; artifact_id : ArtifactId };
  ArtifactTooLarge : record { max : nat64; byte_length : nat64 };
  SemanticVersionTooLong : record { max : nat32 };
};
type ArtifactId = record {
  sha256 : blob;
  semantic_version : text;
  canister_kind : CanisterKind;
};
type ArtifactMetadata = record {
  verified : bool;
  artifact_id : ArtifactId;
  chunk_hashes : vec blob;
  byte_length : nat64;
  created_at_ns : nat64;
  storage_id : nat64;
};
type ArtifactPublishMetadataArgs = record {
  sha256 : blob;
  chunk_hashes : vec blob;
  semantic_version : text;
  byte_length : nat64;
  canister_kind : CanisterKind;
};
type ArtifactUpload = record {
  started_at_ns : nat64;
  artifact_id : ArtifactId;
  received_chunks : vec nat32;
  verified_at_ns : opt nat64;
  state : ArtifactUploadState;
};
type ArtifactUploadChunkArgs = record {
  chunk_index : nat32;
  artifact_id : ArtifactId;
  bytes : blob;
};
type ArtifactUploadState = variant {
  Failed : record { reason : text };
  Receiving;
  Verified : record { verified_at_ns : nat64 };
  Verifying;
};
type BootstrapAuthAction = variant {
  InitialSeed;
  RejectUnauthorized;
  Upsert;
  RejectNotSeeded;
};
type BootstrapAuthEntry = record {
  action : BootstrapAuthAction;
  timestamp_ns : nat64;
  caller : principal;
  deployment_id : opt text;
};
type CanisterKind = variant {
  Router;
  Graph;
  PropertyIndex;
  VectorCanister;
  Inference;
  TextCanister;
};
type ControllerMode = variant { SelfCustody; Managed };
type CreatedResource = record {
  artifact_hash : blob;
  logical_resource : LogicalResource;
  canister_id : principal;
};
type DeploymentGrantScope = variant { Relay; OwnDeployment };
type DeploymentQueryError = variant { Unauthorized; UnknownDeployment };
type DeploymentOwnerUpdateError = variant {
  UnknownDeployment;
  AnonymousOwner;
  Unauthorized;
  SelfCustody;
  InvalidState;
};
type DeploymentRecord = record {
  owner : principal;
  operator : opt principal;
  credit_cycles : nat;
  controller_mode : ControllerMode;
};
type DictCatalogError = variant {
  AlreadyFinalized : DictCatalogKey;
  InvalidRawLen;
  ChunkOutOfOrder : record { expected_chunk_index : nat32; received : nat32 };
  IdentifierTooLong : record { max : nat32 };
  ChunkReplayMismatch : record { chunk_index : nat32 };
  ChunkDigestMismatch : record { chunk_index : nat32 };
  FrameDigestIncomplete;
  NotFound : DictCatalogKey;
  Unauthorized;
  CompressedTooLarge : record { len : nat64; max : nat64 };
  EmptyChunk;
  ReplayMismatch;
  ChunkTooLarge : record { len : nat64; max : nat32 };
};
type DictCatalogFinalizeArgs = record {
  key : DictCatalogKey;
  raw_len : nat64;
  raw_digest : nat;
};
type DictCatalogKey = record { kind : text; version : text };
type DictCatalogState = variant { Uploading; Finalized };
type DictCatalogStatus = record {
  key : DictCatalogKey;
  raw_len : opt nat64;
  chunks_received : nat32;
  raw_digest : opt nat;
  compressed_len : nat64;
  per_frame_digests : vec nat;
  state : DictCatalogState;
};
type DictCatalogUploadChunkArgs = record {
  key : DictCatalogKey;
  chunk_index : nat32;
  bytes : blob;
  frame_digest : nat;
};
type GrantCreditArgs = record {
  amount : nat;
  deployment_id : principal;
  idempotency_key : blob;
};
type GrantCreditError = variant {
  BillingAuthorityNotConfigured;
  UnknownDeployment;
  AmountZero;
  Unauthorized;
  IdempotencyConflict;
  CreditOverflow;
  InvalidState;
};
type GrantCreditResult = record {
  replayed : bool;
  credit_cycles : nat;
  amount : nat;
  deployment_id : principal;
};
type ReverseCreditArgs = record {
  grant_authority : principal;
  idempotency_key : blob;
};
type ReverseCreditError = variant {
  AnonymousGrantAuthority;
  BillingAuthorityNotConfigured;
  InsufficientCredit;
  UnknownGrant;
  Unauthorized;
  InvalidState;
};
type InstallError = variant {
  ArtifactNotFound : ArtifactId;
  NoActiveRelease;
  ManagementCanisterCallFailed : text;
  ChunkStoreNotReconciled;
  TargetCanisterKindForbidden : CanisterKind;
  NoBootstrapAuthority;
  ArtifactNotVerified : ArtifactId;
  Unauthorized;
};
type LogicalResource = variant {
  Router;
  PropertyIndex : nat32;
  VectorIndex : nat32;
  Inference;
  GraphShard : nat32;
  TextIndex : nat32;
};
type ProvisionAcceptResponse = variant {
  Replay : record {
    created_resources : vec CreatedResource;
    intent_lock_count : nat32;
    job_view : ProvisionJobSummary;
  };
  Accepted : record {
    created_resources : vec CreatedResource;
    intent_lock_count : nat32;
    job_view : ProvisionJobSummary;
  };
};
type ProvisionIngressError = variant {
  StateAdvanceFailed;
  UnknownDeployment;
  ResultMappingError;
  NotFound;
  InsufficientCycles : record { available : nat; required : nat };
  NotAuthorized;
  RouterAlreadyIssued : record { request_id : blob };
  InvalidResources : record { reason : text };
  RouterIssuanceInProgress;
  IntentLockHeld;
  InvalidState;
  Conflict;
};
type ProvisionIngressResult = variant {
  Ok : ProvisionAcceptResponse;
  Err : ProvisionIngressError;
};
type ProvisionInitArgs = record { governance_principal : principal };
type ProvisionJobSummary = record {
  request_id : blob;
  active_resource_index : nat32;
  completed_effect_count : nat32;
  state : text;
  deployment_id : principal;
};
type ProvisionJobView = record {
  request_id : blob;
  is_authorized_caller : bool;
  active_resource_index : nat32;
  resources : vec ResourceJobView;
  reserved_graph_id : opt nat32;
  completed_effect_count : nat32;
  graph_name : text;
  state_name : text;
  deployment_id : principal;
};
type ProvisionRequest = record {
  request_id : blob;
  requested_resources : vec ProvisionableResource;
  reserved_graph_id : opt nat32;
  controller_mode : ControllerMode;
  release_id : text;
  install_args : vec blob;
  graph_name : text;
  intent_key : ProvisioningIntentKey;
  deployment_id : principal;
  authorized_caller : principal;
};
type ProvisionableResource = record { logical_resource : LogicalResource };
type ProvisioningIntentKey = record {
  logical_resource : LogicalResource;
  deployment_id : principal;
};
type ReleaseActivateArgs = record { release_id : text };
type ReleaseActivateResult = record {
  activated_at_ns : nat64;
  previous_release_id : opt text;
  release_id : text;
};
type ReleaseError = variant {
  ArtifactNotFound : ArtifactId;
  IncompleteManifest : record { missing : vec ArtifactId; release_id : text };
  ProvisionKindForbidden : ArtifactId;
  NoBootstrapAuthority;
  ArtifactNotVerified : ArtifactId;
  Unauthorized;
  UnknownRelease : text;
  ConflictingRelease : record { requested : text; existing : text };
  NotUniquePerKind : record {
    kind : CanisterKind;
    conflicting : vec ArtifactId;
    release_id : text;
  };
};
type ReleaseInstallArgs = record {
  target_canister_kind : CanisterKind;
  registry_version : nat64;
  install_args : blob;
  target_canister_id : opt principal;
};
type ReleaseInstallResult = record {
  install_chunked_code_hash : blob;
  release_id : text;
  target_canister_id : principal;
  installed_at_ns : nat64;
  installed_chunks : nat32;
};
type ReleaseManifest = record {
  graph_artifact : ArtifactId;
  router_artifact : ArtifactId;
  vector_canister_artifact : ArtifactId;
  release_id : text;
  inference_artifact : ArtifactId;
  text_canister_artifact : ArtifactId;
  property_index_artifact : ArtifactId;
};
type ReleasePublishArgs = record {
  artifact_ids : vec ArtifactId;
  release_id : text;
};
type ResourceJobView = record {
  artifact_hash : opt blob;
  logical_resource : LogicalResource;
  canister_id : opt principal;
};
type Result = variant { Ok : DictCatalogStatus; Err : DictCatalogError };
type Result_1 = variant {
  Ok : DeploymentRecord;
  Err : DeploymentOwnerUpdateError;
};
type Result_14 = variant { Ok : ReleaseActivateResult; Err : ReleaseError };
type Result_15 = variant { Ok : ReleaseInstallResult; Err : InstallError };
type Result_16 = variant { Ok : ReleaseManifest; Err : ReleaseError };
type Result_17 = variant { Ok : GrantCreditResult; Err : ReverseCreditError };
type Result_18 = variant { Ok : DeploymentRecord; Err : TakeOwnershipError };
type Result_19 = variant {
  Ok : BootstrapAuthEntry;
  Err : UpsertDeploymentGrantError;
};
type Result_20 = variant { Ok : WithdrawResult; Err : WithdrawError };
type Result_8 = variant { Ok : vec principal; Err : DeploymentQueryError };
type Result_2 = variant { Ok : ServiceConfig; Err : ServiceConfigUpdateError };
type Result_3 = variant {
  Ok : DeploymentRecord;
  Err : SelfCustodyTransferError;
};
type Result_4 = variant { Ok : vec ArtifactAuditEntry; Err : ArtifactError };
type Result_5 = variant { Ok : ArtifactMetadata; Err : ArtifactError };
type Result_6 = variant { Ok : ArtifactUpload; Err : ArtifactError };
type Result_7 = variant { Ok : DeploymentRecord; Err : DeploymentQueryError };
type Result_9 = variant { Ok : ServiceLedger; Err : WithdrawError };
type Result_10 = variant { Ok : opt WithdrawalRecord; Err : WithdrawError };
type Result_11 = variant { Ok : GrantCreditResult; Err : GrantCreditError };
type Result_12 = variant { Ok : DeploymentRecord; Err : InitializeDeploymentError };
type Result_13 = variant { Ok : AdmissionQuote; Err : AdmissionQuoteError };
type InitializeDeploymentArgs = record {
  owner : principal;
  controller_mode : ControllerMode;
  deployment_id : principal;
};
type InitializeDeploymentError = variant {
  OperatorMismatch;
  OwnerMismatch;
  AnonymousOwner;
  Unauthorized;
  ControllerModeMismatch;
  InvalidState;
  MissingOperator;
};
type RouterRegistrationAck = record {
  request_id : blob;
  deployment_id : principal;
};
type RouterRegistrationAckResponse = variant { Applied; Replay };
type RouterRegistrationAckResult = variant {
  Ok : RouterRegistrationAckResponse;
  Err : ProvisionIngressError;
};
type SelfCustodyTransferError = variant {
  ManagementCallFailed;
  UnknownDeployment;
  AnonymousOwner;
  Unauthorized;
  RollbackFailed : record { canisters : vec principal };
  Managed;
  InvalidState;
  SameOwner;
};
type ServiceConfig = record {
  compensation_cap_cycles : nat;
  require_prepaid_admission : bool;
  operator : opt principal;
  platform_fee_bps : nat16;
  version : nat32;
  billing_authority : opt principal;
  reserve_bps : nat16;
  covered_failure_classes : nat32;
};
type ServiceConfigUpdateError = variant {
  InvalidConfig;
  StaleVersion;
  Unauthorized;
};
type TakeOwnershipError = variant {
  AlreadySelfCustody;
  ManagementCallFailed;
  UnknownDeployment;
  Unauthorized;
  RollbackFailed : record { canisters : vec principal };
  InvalidState;
};
type UpsertDeploymentGrantArgs = record {
  scope : DeploymentGrantScope;
  issuer : principal;
};
type UpsertDeploymentGrantError = variant {
  NoBootstrapAuthority;
  Unauthorized;
};
type WithdrawArgs = record {
  amount : nat;
  destination : principal;
  idempotency_key : blob;
  kind : WithdrawalKind;
};
type WithdrawError = variant {
  AmountZero;
  AnonymousDestination;
  IdempotencyConflict;
  InsufficientLedger;
  InvalidDestination;
  InvalidState;
  OperatorNotConfigured;
  PreviousAttemptFailed;
  TransferFailed : text;
  TransferPending;
  Unauthorized;
};
type WithdrawResult = record { amount : nat; replayed : bool };
type WithdrawalKind = variant { CompensationReserve; PlatformFees };
type WithdrawalRecord = record {
  amount : nat;
  destination : principal;
  kind : WithdrawalKind;
  status : WithdrawalStatus;
};
type WithdrawalStatus = variant { Completed; Failed : text; Pending };
type ServiceLedger = record { compensation_reserve : nat; platform_fees : nat };

service : (ProvisionInitArgs) -> {
  accept_envelope : (ProvisionRequest) -> (ProvisionIngressResult);
  admin_finalize_dict_catalog : (DictCatalogFinalizeArgs) -> (Result);
  admin_get_dict_catalog_status : (DictCatalogKey) -> (
      opt DictCatalogStatus,
    ) query;
  admin_set_deployment_owner : (principal, principal) -> (Result_1);
  admin_set_service_config : (ServiceConfig) -> (Result_2);
  admin_transfer_self_custody : (principal, principal) -> (Result_3);
  admin_upload_dict_catalog_chunk : (DictCatalogUploadChunkArgs) -> (Result);
  artifact_audit_history : () -> (Result_4) query;
  artifact_get_status : (ArtifactId) -> (opt ArtifactUpload) query;
  artifact_publish_metadata : (ArtifactPublishMetadataArgs) -> (Result_5);
  artifact_upload_chunk : (ArtifactUploadChunkArgs) -> (Result_6);
  complete_graph_registration : (RouterRegistrationAck) -> (
      RouterRegistrationAckResult,
    );
  get_deployment : (principal) -> (Result_7) query;
  get_deployment_canisters : (principal) -> (Result_8) query;
  get_service_ledger : () -> (Result_9) query;
  get_withdrawal : (blob) -> (Result_10) query;
  grant_credit : (GrantCreditArgs) -> (Result_11);
  initialize_deployment : (InitializeDeploymentArgs) -> (Result_12);
  query_job : (blob, principal) -> (opt ProvisionJobView) query;
  quote_admission : (nat32) -> (Result_13) query;
  release_activate : (ReleaseActivateArgs) -> (Result_14);
  release_get_active : () -> (opt ReleaseActivateResult) query;
  release_install : (ReleaseInstallArgs) -> (Result_15);
  release_publish : (ReleasePublishArgs) -> (Result_16);
  reverse_credit : (ReverseCreditArgs) -> (Result_17);
  take_ownership : (principal) -> (Result_18);
  upsert_deployment_grant : (UpsertDeploymentGrantArgs) -> (Result_19);
  withdraw_fees : (WithdrawArgs) -> (Result_20);
}
